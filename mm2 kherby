local boxHandles = {}

local function ApplyHitbox(Character)
    if not Character or Character == LocalPlayer.Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if HRP then
        local newSize = Vector3.new(State.Hit.sz, State.Hit.sz, State.Hit.sz)
        HRP.Size = newSize
        HRP.Transparency = 1
        HRP.CanCollide = false
        if State.Hit.viz then
            if not boxHandles[Character] then
                local box = Instance.new("BoxHandleAdornment")
                box.Adornee = HRP
                box.Size = newSize
                box.Color3 = Color3.fromRGB(255, 0, 0)
                box.Transparency = 0.5
                box.AlwaysOnTop = true
                box.ZIndex = 10
                box.Visible = true
                box.Parent = HRP
                boxHandles[Character] = box
            else
                boxHandles[Character].Size = newSize
                boxHandles[Character].Visible = true
            end
        else
            if boxHandles[Character] then
                boxHandles[Character].Visible = false
            end
        end
    end
end

local function UpdateAllHitboxes()
    if not State.Hit.e then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local HRP = p.Character:FindFirstChild("HumanoidRootPart")
                if HRP then
                    HRP.Size = Vector3.new(2, 2, 1)
                end
                if boxHandles[p.Character] then
                    boxHandles[p.Character]:Destroy()
                    boxHandles[p.Character] = nil
                end
            end
        end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            ApplyHitbox(p.Character)
        end
    end
end

