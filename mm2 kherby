-- ===== AUTO AVOID MURDERER =====
local function GetNearestMurdererDist()
    local c=LocalPlayer.Character if not c then return nil end
    local rp=c:FindFirstChild("HumanoidRootPart") if not rp then return nil end
    local nearest=math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isAlive(p) and isMurderer(p) then
            local tc=p.Character
            local thrp=tc and tc:FindFirstChild("HumanoidRootPart")
            if thrp then
                local dist=(rp.Position-thrp.Position).Magnitude
                if dist<nearest then nearest=dist end
            end
        end
    end
    return nearest==math.huge and nil or nearest
end

local function CheckAutoAvoid()
    if not State.AutoAvoid.e then
        if getgenv().Desync and getgenv().Desync.AvoidActive then
            getgenv().Desync.AvoidActive=false
            if getgenv().Desync.Enabled then
                getgenv().Desync.Enabled=false
                State.Desync.a=false
            end
        end
        return
    end
    local dist=GetNearestMurdererDist()
    if dist and dist<=State.AutoAvoid.dist then
        if not getgenv().Desync.Enabled and State.Desync.e then
            getgenv().Desync.AvoidActive=true
            getgenv().Desync.Enabled=true
            State.Desync.a=true
            getgenv().Desync.Method="Sky"
            Notifier.new({Title="Auto Avoid", Content=string.format("Murderer %.1f studs away", dist), Duration=3})
        end
    elseif getgenv().Desync and getgenv().Desync.Enabled and getgenv().Desync.AvoidActive then
        getgenv().Desync.Enabled=false
        State.Desync.a=false
        getgenv().Desync.AvoidActive=false
        Notifier.new({Title="Auto Avoid", Content="Safe distance reached", Duration=3})
    end
end

