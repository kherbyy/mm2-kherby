local function create2DTracer(color)
    local tracerLine = Drawing.new("Line")
    tracerLine.Thickness = 2
    tracerLine.Color = color
    tracerLine.Visible = true
    tracerLine.Transparency = 0.5
    tracerLine.ZIndex = 10
    return tracerLine
end

local function update2DTracer(tracer, targetPosition)
    if not tracer then return end
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    local fromPoint = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    local toPoint, onScreen = camera:WorldToViewportPoint(targetPosition)
    if onScreen then
        tracer.From = fromPoint
        tracer.To = Vector2.new(toPoint.X, toPoint.Y)
        tracer.Visible = true
    else
        tracer.Visible = false
    end
end

local function updateAll2DTracers()
    -- Gun Drop Tracer (Purple)
    if State.gun_tracer then
        local gunDrop = findGunDrop()
        if gunDrop and gunDrop:IsA("BasePart") then
            if not gunTracer then
                gunTracer = create2DTracer(Color3.fromRGB(128, 0, 255))
            end
            update2DTracer(gunTracer, gunDrop.Position)
        elseif gunTracer then
            gunTracer.Visible = false
        end
    elseif gunTracer then
        gunTracer.Visible = false
    end
    
    -- Sheriff Tracer (Blue)
    if State.sheriff_tracer then
        local sheriff = findSheriff()
        if sheriff and sheriff.Character then
            local targetPart = sheriff.Character:FindFirstChild("HumanoidRootPart") or sheriff.Character:FindFirstChild("Head")
            if targetPart then
                if not sheriffTracer then
                    sheriffTracer = create2DTracer(Color3.fromRGB(0, 100, 255))
                end
                update2DTracer(sheriffTracer, targetPart.Position)
            end
        elseif sheriffTracer then
            sheriffTracer.Visible = false
        end
    elseif sheriffTracer then
        sheriffTracer.Visible = false
    end
    
    -- Murderer Tracer (Red)
    if State.murderer_tracer then
        local murderer = findMurderer()
        if murderer and murderer.Character then
            local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("Head")
            if targetPart then
                if not murdererTracer then
                    murdererTracer = create2DTracer(Color3.fromRGB(255, 0, 0))
                end
                update2DTracer(murdererTracer, targetPart.Position)
            end
        elseif murdererTracer then
            murdererTracer.Visible = false
        end
    elseif murdererTracer then
        murdererTracer.Visible = false
    end
end

