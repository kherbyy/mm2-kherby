local function hasItem(plr, itemName)
    if not plr then return false end
    return (plr.Backpack and plr.Backpack:FindFirstChild(itemName)) or (plr.Character and plr.Character:FindFirstChild(itemName))
end

local function isMurderer(plr) return hasItem(plr, "Knife") end
local function isSheriff(plr) return hasItem(plr, "Gun") or hasItem(plr, "Revolver") end
local function isAlive(plr) 
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
local function isInnocent(plr) 
    return plr ~= LocalPlayer and isAlive(plr) and not isMurderer(plr) and not isSheriff(plr) 
end
local function hasGun() return hasItem(LocalPlayer, "Gun") end
local function getCurrentMap()
    if State.MapCache and State.MapCache.Parent then return State.MapCache end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "Spawns" and v.Parent and v.Parent.Name ~= "Lobby" then
            State.MapCache = v.Parent
            return State.MapCache
        end
    end
    State.MapCache = nil
    return nil
end

-- ESP Functions
local function getRoleColor(plr)
    if not plr or not plr.Character then return Color3.fromRGB(0, 255, 0) end
    if isMurderer(plr) then return Color3.fromRGB(255, 0, 0) end
    if isSheriff(plr) then return Color3.fromRGB(0, 100, 255) end
    return Color3.fromRGB(0, 255, 0)
end

local function CleanupESP(char)
    if not char then return end
    local hl = char:FindFirstChild("MM2Highlight")
    local tag = char:FindFirstChild("MM2NameTag")
    if hl then hl:Destroy() end
    if tag then tag:Destroy() end
end

local function CreateESP(char, plr)
    if not char or not plr or plr == LocalPlayer then return end
    CleanupESP(char)
    
    local hl = Instance.new("Highlight")
    hl.Name = "MM2Highlight"
    hl.Adornee = char
    hl.FillColor = getRoleColor(plr)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = State.ESP.FillTransparency
    hl.OutlineTransparency = 0
    hl.Parent = char
    
    if State.ESP.NameTags then
        local adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if adornee then
            local bill = Instance.new("BillboardGui")
            bill.Name = "MM2NameTag"
            bill.Adornee = adornee
            bill.Size = UDim2.new(9, 0, 2.5, 0)
            bill.StudsOffset = Vector3.new(0, 6, 0)
            bill.AlwaysOnTop = true
            bill.LightInfluence = 0
            bill.Parent = char
            
            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1,0,1,0)
            txt.BackgroundTransparency = 0.35
            txt.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            txt.Text = plr.Name
            txt.TextColor3 = getRoleColor(plr)
            txt.TextScaled = true
            txt.Font = Enum.Font.GothamBold
            txt.TextStrokeTransparency = 0
            txt.TextStrokeColor3 = Color3.fromRGB(0,0,0)
            txt.Parent = bill
        end
    end
end

