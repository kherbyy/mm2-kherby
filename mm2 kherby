UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        HoldingMouse2 = State.aimbot_enabled and State.aimbot_active
    elseif input.KeyCode == StringToKeyCode(State.hitbox_keybind) then
        State.hitbox_viz = not State.hitbox_viz
        UpdateAllHitboxes()
        Notifier.new({Title="Hitbox Visuals", Content=State.hitbox_viz and "ON" or "OFF", Duration=2})
    elseif input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.Plus then
        State.hitbox_size = math.min(State.hitbox_size + 5, 50)
        UpdateAllHitboxes()
        Notifier.new({Title="Hitbox Size", Content=tostring(State.hitbox_size), Duration=1.5})
    elseif input.KeyCode == Enum.KeyCode.Minus then
        State.hitbox_size = math.max(State.hitbox_size - 5, 5)
        UpdateAllHitboxes()
        Notifier.new({Title="Hitbox Size", Content=tostring(State.hitbox_size), Duration=1.5})
    elseif input.KeyCode == StringToKeyCode(State.godmode_keybind) then
        if not State.godmode_enabled then
            Notifier.new({Title="God Mode", Content="Enable God Mode in UI first", Duration=3})
            return
        end
        State.godmode_enabled = not State.godmode_enabled
        if State.godmode_enabled then
            if roundActive then
                enableGodMode()
            else
                godModeRequested = true
                Notifier.new({Title="God Mode", Content="Will activate when round starts!", Duration=3})
            end
        else
            godModeRequested = false
            godModeActive = false
            Notifier.new({Title="God Mode", Content="OFF", Duration=2})
        end
    elseif input.KeyCode == StringToKeyCode(State.aimbot_keybind) then
        if not State.aimbot_enabled then
            Notifier.new({Title="Aimbot", Content="Enable Aimbot in UI first", Duration=3})
            return
        end
        State.aimbot_active = not State.aimbot_active
        if not State.aimbot_active then LockedTarget = nil LastLockedTarget = nil end
        Notifier.new({Title="Aimbot", Content=State.aimbot_active and "ACTIVE" or "INACTIVE", Duration=1.5})
    elseif input.KeyCode == StringToKeyCode(State.flick_keybind) then
        if not State.flick_enabled then
            Notifier.new({Title="Flick Shoot", Content="Enable Flick Shoot in UI first", Duration=3})
            return
        end
        performFlickShoot()
    elseif input.KeyCode == StringToKeyCode(State.desync_keybind) then
        if not State.desync_enabled then
            Notifier.new({Title="Desync", Content="Enable Desync in UI first", Duration=3})
            return
        end
        State.desync_active = not State.desync_active
        getgenv().Desync.Enabled = State.desync_active
        if not State.desync_active then getgenv().Desync.AutoAvoidActive = false end
        Notifier.new({Title="Desync", Content=State.desync_active and "ACTIVE" or "INACTIVE", Duration=2})
    elseif input.KeyCode == StringToKeyCode(State.killaura_keybind) then
        if not State.killaura_enabled then
            Notifier.new({Title="Kill All", Content="Enable Kill Aura first", Duration=3})
            return
        end
        PerformKillAll()
    end
end)

