    if not predictedPos then return end
    
    State.silent_hacker_active = true
    Notifier.new({Title="Silent Hacker ACTIVE", Content="Behind "..murderer.Name.." - AUTO SHOOTING!", Duration=3})
    if getgenv().SH_Coroutine then
        pcall(function()
            if coroutine.status(getgenv().SH_Coroutine) ~= "dead" then task.cancel(getgenv().SH_Coroutine) end
        end)
    end
    getgenv().SH_Coroutine = task.spawn(function()
        local startTime = tick()
        while tick() - startTime < State.silent_hacker_duration and State.silent_hacker_active do
            if not rootPart or not rootPart.Parent then stopSilentHacker() return end
            murderer = findMurdererSilentHacker()
            if not murderer or not isAlive(murderer) then stopSilentHacker() return end
            State.silent_hacker_target = murderer
            
            local newIsJumping = isPlayerJumping(murderer.Character)
            local newTargetPart = newIsJumping and murderer.Character:FindFirstChild("HumanoidRootPart") or (murderer.Character:FindFirstChild("UpperTorso") or murderer.Character:FindFirstChild("Torso"))
            local newPredictedPos = predictPlayerPosition(murderer, newTargetPart)
            if not newPredictedPos then task.wait(0.016) continue end
            predictedPos = newPredictedPos
            
            local murdererHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
            if not murdererHRP then task.wait(0.016) continue end
            local murdererLookVector = murdererHRP.CFrame.LookVector
            local behindPosition = predictedPos - (murdererLookVector * State.silent_hacker_distance)
            behindPosition = Vector3.new(behindPosition.X, predictedPos.Y, behindPosition.Z)
            local behindCFrame = CFrame.lookAt(behindPosition, predictedPos)
            local clientVisualPosition = rootPart.CFrame
            rootPart.CFrame = behindCFrame
            RunService.Heartbeat:Wait()
            if rootPart and rootPart.Parent then rootPart.CFrame = clientVisualPosition end
            task.wait(0.016)
        end
        stopSilentHacker()
    end)
    return murderer.Name
end

