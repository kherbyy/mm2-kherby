local triggerConn
local function startTriggerbot()
    if triggerConn then triggerConn:Disconnect() end
    triggerConn = RunService.Heartbeat:Connect(function()
        if not TriggerbotEnabled or not hasGun() then return end
        local mouse = LocalPlayer:GetMouse()
        if not mouse.Target then return end
        local targetPart = mouse.Target
        local char = targetPart:FindFirstAncestorWhichIsA("Model")
        if char then
            local isValidTarget = false
            local bodyParts = {"Head", "Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftHand", "RightHand", "LeftFoot", "RightFoot"}
            for _, partName in ipairs(bodyParts) do
                local bodyPart = char:FindFirstChild(partName)
                if bodyPart and (bodyPart == targetPart or targetPart:IsDescendantOf(bodyPart)) then
                    isValidTarget = true
                    break
                end
            end
            if not isValidTarget then
                if (targetPart:IsA("MeshPart") or targetPart:IsA("Part")) and targetPart.Parent == char and targetPart.Name ~= "HumanoidRootPart" then
                    isValidTarget = true
                end
            end
            if isValidTarget then
                local targetPlr = Players:GetPlayerFromCharacter(char)
                if targetPlr and isMurderer(targetPlr) then
                    local gun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
                    if gun then gun:Activate() end
                end
            end
        end
    end)
end

