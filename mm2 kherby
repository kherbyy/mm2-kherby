-- ===== SILENT HACKER =====
local function FindMurderer() for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer and isAlive(p) and isMurderer(p) then return p end end return nil end
local function PredictMurdererPos(m) if not m or not m.Character then return nil end local hrp=m.Character:FindFirstChild("HumanoidRootPart") if not hrp then return nil end UpdateNet() local pos=hrp.Position local vel=hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.new() local pt=math.clamp((Net.ping/1000)+0.085,0.03,0.2) local pp=pos+(vel*pt) if vel.Y~=0 then local vy=pos.Y+(vel.Y*pt)-(0.5*WS.Gravity*pt^2) pp=Vector3.new(pp.X,vy,pp.Z) end return pp end

local function StopSH() State.SH.desyncing=false State.SH.ctarget=nil if State.SH.coro then pcall(function() if coroutine.status(State.SH.coro)~="dead" then task.cancel(State.SH.coro) end end) State.SH.coro=nil end end

local function PerformSH()
    if State.SH.desyncing or not State.SH.e then return end
    local c=LocalPlayer.Character if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid") if not h or h.Health<=0 then return end
    local rp=c:FindFirstChild("HumanoidRootPart") if not rp then return end
    local m=FindMurderer() if not m then return end
    State.SH.ctarget=m
    local pp=PredictMurdererPos(m) if not pp then return end
    State.SH.desyncing=true
    Notifier.new({Title="Silent Hacker ACTIVE", Content="Behind "..m.Name, Duration=3})
    if State.SH.coro then pcall(function() if coroutine.status(State.SH.coro)~="dead" then task.cancel(State.SH.coro) end end) end
    State.SH.coro=task.spawn(function()
        local st=tick()
        while State.SH.dur-(tick()-st)>0 and State.SH.desyncing do
            if not rp or not rp.Parent then StopSH() return end
            m=FindMurderer() if not m or not isAlive(m) then StopSH() return end
            State.SH.ctarget=m
            local np=PredictMurdererPos(m) if not np then task.wait(0.016) continue end
            pp=np
            local mhrp=m.Character:FindFirstChild("HumanoidRootPart") if not mhrp then task.wait(0.016) continue end
            local behind=pp-(mhrp.CFrame.LookVector*State.SH.bd)
            behind=Vector3.new(behind.X,pp.Y,behind.Z)
            local bcf=CFrame.lookAt(behind,pp)
            local orig=rp.CFrame
            rp.CFrame=bcf
            RunS.Heartbeat:Wait()
            if rp and rp.Parent then rp.CFrame=orig end
            task.wait(0.016)
        end
        StopSH()
    end)
end

