local function setupAntiFling()
    local character = LocalPlayer.Character
    if not character then return end
    
    local antiFlingConnections = {}
    local lastPosition = Vector3.new()
    
    local function StrongAntiFling()
        if not AntiFlingEnabled or not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoid or not rootPart or humanoid.Health <= 0 then return end
        
        if rootPart.Velocity.Magnitude > 150 then
            if lastPosition.Magnitude > 0 then
                rootPart.CFrame = CFrame.new(lastPosition)
            end
            
            rootPart.Velocity = Vector3.new(0, 0, 0)
            rootPart.RotVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part ~= rootPart then
                    part.Velocity = Vector3.new(0, 0, 0)
                    part.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
            
            rootPart.Anchored = true
            task.wait(0.1)
            rootPart.Anchored = false
        else
            if rootPart.Velocity.Magnitude < 20 then
                lastPosition = rootPart.Position
            end
        end
    end
    
    local heartbeatConn = RunService.Heartbeat:Connect(StrongAntiFling)
    table.insert(antiFlingConnections, heartbeatConn)
    
    local function onPartAdded(part)
        if not AntiFlingEnabled then return end
        if part:IsA("BodyVelocity") or part:IsA("BodyPosition") or part:IsA("BodyAngularVelocity") or part:IsA("BodyGyro") or part:IsA("BodyThrust") then
            task.wait()
            if part and part.Parent then
                part:Destroy()
            end
        end
    end
    
    local descendantConn = character.DescendantAdded:Connect(onPartAdded)
    table.insert(antiFlingConnections, descendantConn)
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BodyVelocity") or part:IsA("BodyPosition") or part:IsA("BodyAngularVelocity") or part:IsA("BodyGyro") or part:IsA("BodyThrust") then
            pcall(function() part:Destroy() end)
        end
    end
    
    return function()
        for _, conn in ipairs(antiFlingConnections) do
            conn:Disconnect()
        end
        antiFlingConnections = {}
    end
end

