-- ===== DESYNC & AUTO AVOID LOOP =====
coroutine.wrap(function() while true do RunS.Heartbeat:Wait()
    CheckAutoAvoid()
    local c=LocalPlayer.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then
            local hp=(h.Health/h.MaxHealth)*100
            local d=getgenv().Desync
            if d.AutoDamage and hp<d.HealthThresh and d.LastHealth>hp and tick()-d.LastTrigger>d.Cooldown then
                local rp=c:FindFirstChild("HumanoidRootPart")
                if rp then DesyncData.OrigCF=rp.CFrame DesyncData.Start=tick() if DesyncM[d.Method] then DesyncM[d.Method](rp) end d.LastTrigger=tick() Notifier.new({Title="Auto Desync", Content="Triggered", Duration=3}) end
            end
            d.LastHealth=hp
        end
    end
    if State.Desync.e and State.Desync.a and getgenv().Desync.Enabled then
        local rp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rp then DesyncData.OrigCF=rp.CFrame if DesyncM[getgenv().Desync.Method] then DesyncM[getgenv().Desync.Method](rp) end end
    end
end end)()

