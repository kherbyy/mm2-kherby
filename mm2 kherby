    Name = "God Mode",
    CurrentValue = false,
    Callback = function(Value)
        GodModeEnabled = Value
        if Value then
            enableGodMode()
            Rayfield:Notify({ Title = "God Mode", Content = "ON", Duration = 2 })
        else
            Rayfield:Notify({ Title = "God Mode", Content = "OFF", Duration = 2 })
        end
    end,
})

AntiFlingToggle = Tab:CreateToggle({
    Name = "Anti-Fling",
    CurrentValue = false,
    Callback = function(Value)
        AntiFlingEnabled = Value
        Rayfield:Notify({ Title = "Anti-Fling", Content = Value and "ON" or "OFF", Duration = 2 })
    end,
})

Tab:CreateLabel("Press G for god mode\nU = toggle hitbox visuals\nQ = Aimbot toggle")

Tab:CreateSection("Hitbox Expander")
Tab:CreateToggle({
    Name = "Hitbox Expander",
    CurrentValue = false,
    Callback = function(Value)
        HitboxEnabled = Value
        if Value then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    ApplyHitboxExpander(plr.Character)
                end
            end
            Rayfield:Notify({ Title = "Hitbox", Content = "Enabled", Duration = 2 })
        else
            ResetHitboxes()
            Rayfield:Notify({ Title = "Hitbox", Content = "Disabled", Duration = 2 })
        end
    end,
})

Tab:CreateToggle({
    Name = "Visualize Hitbox",
    CurrentValue = false,
    Callback = function(Value)
        VisualizeHitbox = Value
        UpdateAllHitboxes()
    end,
})

Tab:CreateSlider({
    Name = "Hitbox Size",
    Range = {5, 50},
    Increment = 5,
    CurrentValue = 10,
    Callback = function(Value)
        HitboxSize = Value
        if HitboxEnabled then UpdateAllHitboxes() end
    end,
})

Tab:CreateLabel("U to toggle visual hitbox")

Rayfield:LoadConfiguration()
Rayfield:Notify({
    Title = "I Love Annie - MM2",
    Content = "FULL SCRIPT LOADED!\nAuto config save enabled\nNames now show above heads with role colors",
    Duration = 6,
})
