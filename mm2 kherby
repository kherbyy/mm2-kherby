local function getWeaponService()
    local success, result = pcall(function()
        return require(game:GetService("ReplicatedStorage"):WaitForChild("ClientServices"):WaitForChild("WeaponService"))
    end)
    if success then
        return result
    end
    return nil
end

local function isMurderer(plr)
    if not plr then return false end
    return (plr.Backpack:FindFirstChild("Knife") or (plr.Character and plr.Character:FindFirstChild("Knife")))
end

local function isAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end

local function isSheriff(plr)
    if not plr then return false end
    local gunNames = {"Gun", "Revolver"}
    for _, name in ipairs(gunNames) do
        if plr.Backpack:FindFirstChild(name) or (plr.Character and plr.Character:FindFirstChild(name)) then
            return true
        end
    end
    return false
end

local function getMurdererTargetPosition()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and isMurderer(plr) then
            local character = plr.Character
            local targetPart = character:FindFirstChild(aimPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local targetPos = targetPart.Position
               
                if predictionEnabled then
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp.Velocity and hrp.Velocity.Magnitude > 3 then
                        targetPos = targetPos + (hrp.Velocity * predictionAmount)
                    end
                end
               
                return targetPos
            end
        end
    end
    return nil
end

local function setupSilentAim()
    WeaponService = getWeaponService()
    if WeaponService and WeaponService.GetMouseTargetCFrame then
        originalGetTarget = WeaponService.GetMouseTargetCFrame
       
        WeaponService.GetMouseTargetCFrame = function(self)
            if silentAimEnabled then
                if aimOnlyWhenHolding then
                    if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then
                        return originalGetTarget(self)
                    end
                end
               
                local targetPos = getMurdererTargetPosition()
                if targetPos then
                    return CFrame.new(targetPos)
                end
            end
            return originalGetTarget(self)
        end
       
        Notifier.new({
            Title = "Silent Aim Ready",
            Content = "WeaponService hooked successfully",
            Duration = 2
        })
    end
end

