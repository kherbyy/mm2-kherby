                if aimOnlyWhenHolding and not (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then
                    return originalGetTarget(self)
                end
                local targetPos = getMurdererTargetPosition()
                if targetPos then return CFrame.new(targetPos) end
            end
            return originalGetTarget(self)
        end
        Notifier.new({Title="Silent Aim Ready", Content="WeaponService hooked successfully", Duration=2})
    end
end

