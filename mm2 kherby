local function SetupPlayerESP(plr)
    if plr == LocalPlayer then return end
    local function OnToolChange()
        task.wait(0.08)
        if ESPEnabled and plr.Character and isAlive(plr) then
            CreateESP(plr.Character, plr)
        else
            UpdateAllESPColors()
        end
    end
    plr.Backpack.ChildAdded:Connect(function(c)
        if c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver" then OnToolChange() end
    end)
    plr.Backpack.ChildRemoved:Connect(function(c)
        if c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver" then OnToolChange() end
    end)
    if plr.Character then
        plr.Character.ChildAdded:Connect(function(c)
            if c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver" then OnToolChange() end
        end)
        plr.Character.ChildRemoved:Connect(function(c)
            if c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver" then OnToolChange() end
        end)
    end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.85)
        if ESPEnabled and char.Parent then
            CreateESP(char, plr)
        end
    end)
    plr.CharacterRemoving:Connect(function(char)
        CleanupESP(char)
    end)
    if plr.Character then
        task.spawn(function()
            task.wait(1.2)
            if ESPEnabled then CreateESP(plr.Character, plr) end
        end)
    end
end

