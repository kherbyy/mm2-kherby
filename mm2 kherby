findMurdererSilentHacker = function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) and isMurderer(player) then return player end
    end
    return nil
end

stopSilentHacker = function()
    State.silent_hacker_active = false
    State.silent_hacker_target = nil
    if getgenv().SH_Coroutine then
        pcall(function()
            if coroutine.status(getgenv().SH_Coroutine) ~= "dead" then task.cancel(getgenv().SH_Coroutine) end
        end)
        getgenv().SH_Coroutine = nil
    end
end

performSilentHacker = function()
    if State.silent_hacker_active then return end
    if not State.silent_hacker_enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local murderer = findMurdererSilentHacker()
    if not murderer then return end
    State.silent_hacker_target = murderer
    
    local targetPart = getTargetPart(murderer.Character, "Torso") or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    
    local myChar = LocalPlayer.Character
    local myPosition = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Vector3.new()
    local predictedPos = predictPositionWithDivision(targetPart, myPosition, 5, 5)
    if not predictedPos then return end
    
    State.silent_hacker_active = true
    Notifier.new({Title="Silent Hacker ACTIVE", Content="Behind "..murderer.Name.." - AUTO SHOOTING!", Duration=3})
    if getgenv().SH_Coroutine then
        pcall(function()
            if coroutine.status(getgenv().SH_Coroutine) ~= "dead" then task.cancel(getgenv().SH_Coroutine) end
        end)
    end
    getgenv().SH_Coroutine = task.spawn(function()
        local startTime = tick()
        while tick() - startTime < State.silent_hacker_duration and State.silent_hacker_active do
            if not rootPart or not rootPart.Parent then stopSilentHacker() return end
            murderer = findMurdererSilentHacker()
            if not murderer or not isAlive(murderer) then stopSilentHacker() return end
            State.silent_hacker_target = murderer
            
            local newTargetPart = getTargetPart(murderer.Character, "Torso") or murderer.Character:FindFirstChild("HumanoidRootPart")
            local newPredictedPos = predictPositionWithDivision(newTargetPart, myPosition, 5, 5)
            if not newPredictedPos then task.wait(0.016) continue end
            predictedPos = newPredictedPos
            
            local murdererHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
            if not murdererHRP then task.wait(0.016) continue end
            local murdererLookVector = murdererHRP.CFrame.LookVector
            local behindPosition = predictedPos - (murdererLookVector * State.silent_hacker_distance)
            behindPosition = Vector3.new(behindPosition.X, predictedPos.Y, behindPosition.Z)
            local behindCFrame = CFrame.lookAt(behindPosition, predictedPos)
            local clientVisualPosition = rootPart.CFrame
            rootPart.CFrame = behindCFrame
            RunService.Heartbeat:Wait()
            if rootPart and rootPart.Parent then rootPart.CFrame = clientVisualPosition end
            task.wait(0.016)
        end
        stopSilentHacker()
    end)
    return murderer.Name
end

