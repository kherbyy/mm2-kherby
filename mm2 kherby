-- Aim smoothing with separate X/Y
local function applySmooth(current, target, smoothX, smoothY)
    return Vector2.new(
        current.X + (target.X - current.X) * (smoothX / 100),
        current.Y + (target.Y - current.Y) * (smoothY / 100)
    )
end

getBestTarget = function()
    if not State.aimbot_enabled or not State.aimbot_active then return nil end
    if State.aimbot_sticky and LockedTarget and isAlive(LockedTarget) then return LockedTarget end
    local camera = Workspace.CurrentCamera
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and plr.Character then
            local targetPart = getTargetPart(plr.Character, State.aimbot_hitpart)
            if targetPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < State.aimbot_fov then
                        local score = dist
                        if isMurderer(plr) then score = score * 0.15 end
                        if score < bestScore then bestScore = score bestTarget = plr end
                    end
                end
            end
        end
    end
    if State.aimbot_sticky and bestTarget then LockedTarget = bestTarget end
    return bestTarget
end

updateAimbot = function()
    if not State.aimbot_enabled or not State.aimbot_active or not HoldingMouse2 then return end
    local targetPlr = getBestTarget()
    if not targetPlr or not targetPlr.Character then return end
    
    local targetPart = getTargetPart(targetPlr.Character, State.aimbot_hitpart)
    if not targetPart then return end
    
    -- Get my position for prediction
    local myChar = LocalPlayer.Character
    local myPosition = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Vector3.new()
    
    -- Predict with aimbot prediction divisions
    local predictedPos = predictPositionWithDivision(targetPart, myPosition, State.aimbot_prediction_x, State.aimbot_prediction_y)
    
    local camera = Workspace.CurrentCamera
    local currentCFrame = camera.CFrame
    local targetCFrame = CFrame.new(currentCFrame.Position, predictedPos)
    
    if State.aimbot_aimtype == "mouse" then
        -- Move mouse smoothly
        local screenPos, onScreen = camera:WorldToViewportPoint(predictedPos)
        if onScreen then
            local currentMouse = UserInputService:GetMouseLocation()
            local targetMouse = Vector2.new(screenPos.X, screenPos.Y)
            local newMouse = applySmooth(currentMouse, targetMouse, State.aimbot_smooth_x, State.aimbot_smooth_y)
            mousemoveabs(newMouse.X, newMouse.Y)
        end
    else -- memory aim (camera)
        local smoothFactorX = 1 - (State.aimbot_smooth_x / 100)
        local smoothFactorY = 1 - (State.aimbot_smooth_y / 100)
        local smoothFactor = (smoothFactorX + smoothFactorY) / 2
        camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothFactor)
    end
    
    if targetPlr ~= LastLockedTarget then LastLockedTarget = targetPlr end
end

RunService:BindToRenderStep("AnnieAimbotCamlock", Enum.RenderPriority.Camera.Value + 1, updateAimbot)

