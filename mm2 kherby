-- ===== NETWORK & PREDICTION =====
local PredData, Gravity = {}, WS.Gravity
local Net = {ping=0,variance=0,jitter=0,std=0,lastUpdate=0,history={},max=200,buffer=0,stability=1}
local function GetPing() local p=0 pcall(function() p=LocalPlayer:GetNetworkPing()*1000 end) if p==0 then local s=Stats.Network.ServerStatsItem["Data Ping"] if s then p=tonumber(s:GetValueString():match("%d+")) or 0 end end return math.clamp(p,2,500) end
local function CalcStd(d) if #d<2 then return 0 end local s=0 for _,v in ipairs(d) do s=s+v end local m=s/#d local vs=0 for _,v in ipairs(d) do vs=vs+(v-m)^2 end return math.sqrt(vs/#d) end
local function UpdateNet() local ct=tick() if ct-Net.lastUpdate<0.1 then return end local rp=GetPing() table.insert(Net.history,1,rp) if #Net.history>Net.max then table.remove(Net.history) end if #Net.history>=30 then local rp2={} for i=1,math.min(50,#Net.history) do table.insert(rp2,Net.history[i]) end local s=0 for _,p in ipairs(rp2) do s=s+p end local avg=s/#rp2 Net.std=CalcStd(rp2) Net.variance=Net.std^2 Net.jitter=Net.std*0.6 Net.ping=avg local sc=0 for _,p in ipairs(rp2) do if math.abs(p-avg)<Net.std*1.5 then sc=sc+1 end end Net.stability=sc/#rp2 Net.buffer=(Net.ping+Net.jitter*1.2)/1000 else Net.ping=rp Net.buffer=rp/1000 Net.stability=0.5 end Net.lastUpdate=ct end

local function InitPlayer(p) if not PredData[p] then PredData[p]={lastPos=Vector3.new(),lastVel=Vector3.new(),lastTime=tick(),posHist={},velHist={},dirHist={},strafe=0,lastStrafe=0} end return PredData[p] end
local function IsJumping(c) if not c then return false end local h=c:FindFirstChildOfClass("Humanoid") if not h then return false end local r=c:FindFirstChild("HumanoidRootPart") if r then local vy=r.AssemblyLinearVelocity and r.AssemblyLinearVelocity.Y or 0 return vy>5 and h.FloorMaterial==Enum.Material.Air end return false end

local function PredictPos(p, targetPart)
    if not p or not p.Character then return targetPart and targetPart.Position or Vector3.new() end
    local c=p.Character
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not hrp then return targetPart and targetPart.Position or Vector3.new() end
    UpdateNet()
    local d=InitPlayer(p)
    local ct=tick()
    local cp=hrp.Position
    local cv=hrp.Velocity
    table.insert(d.posHist,1,{pos=cp,time=ct})
    if #d.posHist>15 then table.remove(d.posHist) end
    table.insert(d.velHist,1,{vel=cv,time=ct})
    if #d.velHist>15 then table.remove(d.velHist) end
    if cv.Magnitude>1 then table.insert(d.dirHist,1,cv.Unit) if #d.dirHist>10 then table.remove(d.dirHist) end end
    local isJump=IsJumping(c)
    local target=isJump and "HumanoidRootPart" or "UpperTorso"
    local part=c:FindFirstChild(target) or c:FindFirstChild("Torso") or targetPart or hrp
    local tPos=part.Position
    local vel=part.AssemblyLinearVelocity or Vector3.new()
    local predTime=math.clamp(Net.buffer+0.03+math.min(vel.Magnitude/2000,0.08),0.04,0.2)
    local predPos=tPos+(vel*predTime)
    if vel.Y~=0 then local vy=tPos.Y+(vel.Y*predTime)-(0.5*Gravity*predTime^2) predPos=Vector3.new(predPos.X,vy,predPos.Z) end
    if isJump then predPos=Vector3.new(predPos.X,predPos.Y-1.8,predPos.Z) end
    return predPos
end

