UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Enum.KeyCode.U then
        if VisualizeHitboxToggle then
            VisualizeHitbox = not VisualizeHitbox
            UpdateAllHitboxes()
            Notifier.new({Title = "Hitbox Visuals", Content = VisualizeHitbox and "ON" or "OFF", Duration = 2})
        end
    elseif input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.Plus then
        if HitboxEnabled then
            HitboxSize = math.min(HitboxSize + HitboxStep, MaxHitboxSize)
            UpdateAllHitboxes()
            Notifier.new({Title = "Hitbox Size", Content = tostring(HitboxSize), Duration = 1.5})
        end
    elseif input.KeyCode == Enum.KeyCode.Minus then
        if HitboxEnabled then
            HitboxSize = math.max(HitboxSize - HitboxStep, MinHitboxSize)
            UpdateAllHitboxes()
            Notifier.new({Title = "Hitbox Size", Content = tostring(HitboxSize), Duration = 1.5})
        end
    elseif input.KeyCode == Enum.KeyCode.G then
        if GodModeEnabled then
            GodModeEnabled = not GodModeEnabled
            if GodModeEnabled then enableGodMode() end
            Notifier.new({Title = "God Mode", Content = GodModeEnabled and "ON" or "OFF", Duration = 1.5})
        else
            Notifier.new({Title = "God Mode", Content = "Enable from UI first", Duration = 2})
        end
    elseif input.KeyCode == Enum.KeyCode.Q then
        if AimbotEnabled then
            AimbotEnabled = not AimbotEnabled
            Notifier.new({Title = "Aimbot", Content = AimbotEnabled and "ON" or "OFF", Duration = 1.5})
        end
    elseif input.KeyCode == Enum.KeyCode.Z then
        if getgenv().Desync.Enabled then
            local newDesync = not getgenv().Desync.Enabled
            getgenv().Desync.Enabled = newDesync
            if not newDesync then
                getgenv().Desync.AutoAvoidActive = false
            end
            Notifier.new({Title = "Desync", Content = newDesync and "ON" or "OFF", Duration = 2})
        end
    elseif input.KeyCode == Enum.KeyCode.K then
        if KillAuraEnabled then
            PerformKillAll()
        else
            Notifier.new({Title = "Kill All", Content = "Enable Kill Aura first", Duration = 2})
        end
    end
end)

