            hrp.CFrame = spawnPoint.CFrame * CFrame.new(0, 5, 0)
            Rayfield:Notify({Title = "Success", Content = "Teleported to Lobby", Duration = 3})
            return
        end
    end
    local fallbackSpots = {
        CFrame.new(-90.5, 20.5, -9.5),
        CFrame.new(-94, 20.5, -12),
        CFrame.new(-87, 20.5, -7),
        CFrame.new(-100, 25, 0)
    }
    for i, cf in ipairs(fallbackSpots) do
        hrp.CFrame = cf
        task.wait(0.1)
        if hrp.Position.Y > 0 and hrp.Position.Y < 1000 then
            Rayfield:Notify({Title = "Success", Content = "Lobby (Fallback " .. i .. ")", Duration = 3})
            return
        end
    end
end

