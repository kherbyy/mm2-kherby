    if State.AntiFling.e then SetupAntiFling() end
    if State.Noclip.e then SetupNoclip() end
    if State.God.e then EnableGod() end
    if Appearance.Korblox then ApplyKorblox() end
    if Appearance.Headless then ApplyHeadless() end
    PredData = {}
    RefreshAllESP()
    UpdateAllHitboxes()
end)

LocalPlayer.CharacterRemoving:Connect(function()
    DisableAntiFling()
    DisableNoclip()
    DisableInfJump()
end)

if LocalPlayer.Character then
    task.wait(1)
    if State.AntiFling.e then SetupAntiFling() end
    if State.Noclip.e then SetupNoclip() end
    if State.InfJump.e then SetupInfJump() end
    if Appearance.Korblox then ApplyKorblox() end
    if Appearance.Headless then ApplyHeadless() end
    ApplyWalk()
    RefreshAllESP()
    UpdateAllHitboxes()
end

Notifier.new({Title="MM2", Content="Loaded", Duration=6})
