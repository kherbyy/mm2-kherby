-- Teleport Functions
local function findLobby()
    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then return lobby end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "Spawns" and v.Parent and v.Parent.Name == "Lobby" then
            return v.Parent
        end
    end
    return nil
end

local function getSpawnPoint(location)
    if not location then return nil end
    local spawns = location:FindFirstChild("Spawns")
    if spawns then
        for _, child in ipairs(spawns:GetChildren()) do
            if child:IsA("BasePart") then return child end
        end
    end
    for _, child in ipairs(location:GetChildren()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local function tpLobby()
    local char = LocalPlayer.Character
    if not char then Notifier.new({Title="Error", Content="Character not loaded", Duration=3}) return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then Notifier.new({Title="Error", Content="No HumanoidRootPart", Duration=3}) return end
    
    local lobby = findLobby()
    if lobby then
        local spawnPoint = getSpawnPoint(lobby)
        if spawnPoint then
            hrp.CFrame = spawnPoint.CFrame * CFrame.new(0, 5, 0)
            Notifier.new({Title="Success", Content="Teleported to Lobby", Duration=3})
            return
        end
    end
    
    local fallbackSpots = {
        CFrame.new(-90.5, 20.5, -9.5),
        CFrame.new(-94, 20.5, -12),
        CFrame.new(-87, 20.5, -7),
        CFrame.new(-100, 25, 0)
    }
    
    for i, cf in ipairs(fallbackSpots) do
        hrp.CFrame = cf
        task.wait(0.1)
        if hrp.Position.Y > 0 and hrp.Position.Y < 1000 then
            Notifier.new({Title="Success", Content="Lobby (Fallback "..i..")", Duration=3})
            return
        end
    end
end

local function tpMap()
    local char = LocalPlayer.Character
    if not char then Notifier.new({Title="Error", Content="Character not loaded", Duration=3}) return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then Notifier.new({Title="Error", Content="No HumanoidRootPart", Duration=3}) return end
    
    local map = getCurrentMap()
    if map then
        local spawnPoint = getSpawnPoint(map)
        if spawnPoint then
            hrp.CFrame = spawnPoint.CFrame * CFrame.new(0, 5, 0)
            Notifier.new({Title="Success", Content="Teleported to Map", Duration=3})
            return
        end
    end
    Notifier.new({Title="Failed", Content="No map found", Duration=4})
end

