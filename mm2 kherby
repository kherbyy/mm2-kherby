            if not SelectedPlayerName then Notifier.new({Title="Spectate", Content="Select a player first", Duration=2.5}) return end
            local target = Players:FindFirstChild(SelectedPlayerName)
            if target and target.Character and target.Character:FindFirstChild("Humanoid") then
                OriginalCameraSubject = Workspace.CurrentCamera.CameraSubject
                Workspace.CurrentCamera.CameraSubject = target.Character.Humanoid
                Notifier.new({Title="Spectating", Content=SelectedPlayerName, Duration=3})
            end
        elseif OriginalCameraSubject then
            Workspace.CurrentCamera.CameraSubject = OriginalCameraSubject
            OriginalCameraSubject = nil
            Notifier.new({Title="Spectate", Content="Stopped", Duration=2})
        end
    end,
})

