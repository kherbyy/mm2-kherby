PlayersActionsSection = PlayersTab:DrawSection({ Name = "Player Actions", Position = 'left' })

TeleportToSelected = function()
    if not SelectedPlayerName then Notifier.new({Title="Error", Content="No player selected", Duration=2}) return end
    local target = Players:FindFirstChild(SelectedPlayerName)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHRP then myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 4, 0) end
    end
end

FlingSelected = function()
    if not SelectedPlayerName then Notifier.new({Title="Fling Error", Content="No player selected", Duration=2}) return end
    local target = Players:FindFirstChild(SelectedPlayerName)
    if target and target ~= LocalPlayer and target.Character then
        Notifier.new({Title="Fling", Content="Flinging "..target.Name, Duration=2})
        task.spawn(SkidFling, target)
    else Notifier.new({Title="Fling Error", Content="Target invalid", Duration=2}) end
end

FlingByRole = function(findFunc, roleName)
    Notifier.new({Title="Fling", Content="Searching for "..roleName.."...", Duration=2})
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and findFunc(plr) then
            Notifier.new({Title="Fling", Content="Found "..roleName..": "..plr.Name, Duration=2})
            task.spawn(SkidFling, plr)
            return
        end
    end
    Notifier.new({Title="Fling", Content="No "..roleName.." found", Duration=2})
end

FlingInnocents = function()
    Notifier.new({Title="Fling Innocents", Content="Searching for Innocent players...", Duration=2})
    local innocents = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and isInnocent(plr) then table.insert(innocents, plr) end
    end
    if #innocents == 0 then Notifier.new({Title="Fling Innocents", Content="No Innocent players found", Duration=3}) return end
    Notifier.new({Title="Fling Innocents", Content="Found "..#innocents.." Innocent players", Duration=2})
    local function flingNext(index)
        if index > #innocents then Notifier.new({Title="Fling Innocents", Content="Finished flinging all Innocents", Duration=3}) return end
        local target = innocents[index]
        Notifier.new({Title="Fling Innocents", Content="Flinging "..target.Name.." ("..index.."/"..#innocents..")", Duration=2})
        SkidFling(target, function() task.wait(0.5); flingNext(index + 1) end)
    end
    flingNext(1)
end

FlingAll = function()
    Notifier.new({Title="Fling All", Content="Starting to fling all players...", Duration=3})
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and isAlive(plr) then table.insert(targets, plr) end end
    local function flingNext(index)
        if index > #targets then Notifier.new({Title="Fling All", Content="Flung "..#targets.." players total", Duration=4}) return end
        local target = targets[index]
        Notifier.new({Title="Fling All", Content="Flinging "..target.Name.." ("..index.."/"..#targets..")", Duration=2})
        SkidFling(target, function() task.wait(0.5); flingNext(index + 1) end)
    end
    flingNext(1)
end

