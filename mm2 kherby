HoldingMouse2 = false
LockedTarget = nil
LastLockedTarget = nil
BoxHandles = {}

getPlayerNames = function()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer then table.insert(names, plr.Name) end end
    table.sort(names)
    return names
end

getBestTarget = function()
    if not State.aimbot_enabled or not State.aimbot_active then return nil end
    if State.aimbot_sticky and LockedTarget and isAlive(LockedTarget) then return LockedTarget end
    local camera = Workspace.CurrentCamera
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and plr.Character then
            if State.aimbot_murderer_only and not isMurderer(plr) then continue end
            local isJumping = isPlayerJumping(plr.Character)
            local targetPart = isJumping and plr.Character:FindFirstChild("HumanoidRootPart") or (plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso"))
            if not targetPart then targetPart = plr.Character:FindFirstChild("Head") end
            if targetPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < State.aimbot_fov then
                        local score = dist
                        if isMurderer(plr) then score = score * 0.15 end
                        if score < bestScore then bestScore = score bestTarget = plr end
                    end
                end
            end
        end
    end
    if State.aimbot_sticky and bestTarget then LockedTarget = bestTarget end
    return bestTarget
end

updateAimbot = function()
    if not State.aimbot_enabled or not State.aimbot_active or not HoldingMouse2 then return end
    local targetPlr = getBestTarget()
    if not targetPlr or not targetPlr.Character then return end
    
    local isJumping = isPlayerJumping(targetPlr.Character)
    local targetPart = isJumping and targetPlr.Character:FindFirstChild("HumanoidRootPart") or (targetPlr.Character:FindFirstChild("UpperTorso") or targetPlr.Character:FindFirstChild("Torso"))
    if not targetPart then targetPart = targetPlr.Character:FindFirstChild("HumanoidRootPart") end
    if not targetPart then return end
    
    local predictedPos = predictPlayerPosition(targetPlr, targetPart)
    
    local camera = Workspace.CurrentCamera
    local currentCFrame = camera.CFrame
    local targetCFrame = CFrame.new(currentCFrame.Position, predictedPos)
    local smooth = isMurderer(targetPlr) and 0.78 or State.aimbot_smooth
    camera.CFrame = currentCFrame:Lerp(targetCFrame, smooth)
    if targetPlr ~= LastLockedTarget then LastLockedTarget = targetPlr end
end

RunService:BindToRenderStep("AnnieAimbotCamlock", Enum.RenderPriority.Camera.Value + 1, updateAimbot)

