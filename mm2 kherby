RoleCache = {}

updateRoleCache = function(data)
    for name, info in pairs(data) do
        RoleCache[name] = {
            Role = info.Role,
            Dead = info.Dead,
            Perk = info.Perk,
            Knife = info.Knife,
            Gun = info.Gun,
        }
    end
end

fetchInitialRoles = function()
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        remote = remote:FindFirstChild("Gameplay")
        if remote then
            local getData = remote:FindFirstChild("GetCurrentPlayerData")
            if getData then
                local success, data = pcall(getData.InvokeServer, getData)
                if success and type(data) == "table" then
                    updateRoleCache(data)
                end
            end
        end
    end
    local success, module = pcall(require, ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CurrentRoundClient"))
    if success and module.PlayerData then
        updateRoleCache(module.PlayerData)
    end
end

