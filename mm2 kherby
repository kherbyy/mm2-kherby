local function isMurderer(plr)
    if not plr then return false end
    return plr.Backpack:FindFirstChild("Knife") or (plr.Character and plr.Character:FindFirstChild("Knife"))
end

local function hasGun()
    return LocalPlayer.Backpack:FindFirstChild("Gun") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun"))
end

local function getMurdererHead()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isMurderer(plr) and plr.Character and plr.Character:FindFirstChild("Head") then
            return plr.Character.Head
        end
    end
    return nil
end

local function getRoleColor(plr)
    if not plr or not plr.Character then return Color3.fromRGB(0, 255, 0) end
    if isMurderer(plr) then
        return Color3.fromRGB(255, 0, 0)
    elseif plr.Backpack:FindFirstChild("Gun") or (plr.Character and plr.Character:FindFirstChild("Gun")) then
        return Color3.fromRGB(0, 0, 255)
    else
        return Color3.fromRGB(0, 255, 0)
    end
end

-- Function to find current map (from Zynic's script)
local function getCurrentMap()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "Spawns" and v.Parent.Name ~= "Lobby" then
            return v.Parent
        end
    end
    return nil
end

-- Function to update gun tracer
local function updateGunTracer()
    if not DroppedGunTracerEnabled then
        gunTracer.Visible = false
        return
    end
    
    local currentMap = getCurrentMap()
    if not currentMap then 
        gunTracer.Visible = false
        return 
    end
    
    local gunDrop = currentMap:FindFirstChild("GunDrop")
    if gunDrop then
        local gunPosition = gunDrop.Position
        local screenPos, onScreen = Camera:WorldToViewportPoint(gunPosition)
        
        if onScreen then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            gunTracer.From = screenCenter
            gunTracer.To = Vector2.new(screenPos.X, screenPos.Y)
            gunTracer.Visible = true
        else
            gunTracer.Visible = false
        end
    else
        gunTracer.Visible = false
    end
end

-- Function to highlight dropped gun using GunDrop method
local function highlightDroppedGun()
    if not DroppedGunHighlightEnabled then
        -- Remove all GunDrop highlights
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "GunDrop" then
                if obj:FindFirstChild("GunDropHighlight") then
                    obj.GunDropHighlight:Destroy()
                end
                if obj:FindFirstChild("GunDropLabel") then
                    obj.GunDropLabel:Destroy()
                end
            end
        end
        return
    end
    
    local currentMap = getCurrentMap()
    if not currentMap then return end
    
    local gunDrop = currentMap:FindFirstChild("GunDrop")
    if gunDrop and not gunDrop:FindFirstChild("GunDropHighlight") then
        -- Remove old highlights if they exist
        if gunDrop:FindFirstChild("GunDropHighlight") then
            gunDrop.GunDropHighlight:Destroy()
        end
        if gunDrop:FindFirstChild("GunDropLabel") then
            gunDrop.GunDropLabel:Destroy()
        end
        
        -- Create highlight
        local hl = Instance.new("Highlight")
        hl.Name = "GunDropHighlight"
        hl.Adornee = gunDrop
        hl.FillColor = Color3.fromRGB(255, 215, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.3
        hl.Parent = gunDrop
        
        -- Add billboard
        local bill = Instance.new("BillboardGui")
        bill.Name = "GunDropLabel"
        bill.Adornee = gunDrop
        bill.Size = UDim2.new(0, 100, 0, 30)
        bill.StudsOffset = Vector3.new(0, 3, 0)
        bill.AlwaysOnTop = true
        bill.Parent = gunDrop
        
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1,0,1,0)
        txt.BackgroundTransparency = 1
        txt.Text = "DROPPED GUN"
        txt.TextColor3 = Color3.fromRGB(255, 215, 0)
        txt.TextScaled = true
        txt.Font = Enum.Font.GothamBold
        txt.Parent = bill
    end
end

