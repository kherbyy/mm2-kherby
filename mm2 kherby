    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
            pcall(function()
                if v.Enabled then
                    table.insert(DisabledAssets, {obj = v, prop = "Enabled", value = true})
                    v.Enabled = false
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("Part") or v:IsA("Union") or v:IsA("BasePart") then
            pcall(function()
                if v.Material ~= Enum.Material.SmoothPlastic then
                    table.insert(DisabledAssets, {obj = v, prop = "Material", value = v.Material})
                    v.Material = Enum.Material.SmoothPlastic
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Explosion") or v:IsA("Sparkles") or v:IsA("Fire") then
            pcall(function()
                if v.Enabled then
                    table.insert(DisabledAssets, {obj = v, prop = "Enabled", value = true})
                    v.Enabled = false
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("Sky") then
            pcall(function()
                table.insert(DisabledAssets, {obj = v, prop = "Parent", value = v.Parent})
                v.Parent = nil
            end)
        end
    end
end

DisableFPSBooster = function()
    for _, asset in ipairs(DisabledAssets) do
        pcall(function()
            if asset.obj then
                if asset.prop == "Parent" then
                    if asset.value then asset.obj.Parent = asset.value end
                else
                    asset.obj[asset.prop] = asset.value
                end
            end
        end)
    end
    DisabledAssets = {}
end

descendantConnection = nil
MonitorForNewAssets = function()
    if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
    if not FPSBoosterEnabled then return end
    descendantConnection = game.DescendantAdded:Connect(function(v)
        if not FPSBoosterEnabled then return end
        task.wait(0.1)
        if v:IsA("Decal") or v:IsA("Texture") then
            pcall(function() v.Texture = "" end)
        elseif v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
            pcall(function() v.Enabled = false end)
        elseif v:IsA("Part") or v:IsA("Union") or v:IsA("BasePart") then
            pcall(function() v.Material = Enum.Material.SmoothPlastic end)
        elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Explosion") or v:IsA("Sparkles") or v:IsA("Fire") then
            pcall(function() v.Enabled = false end)
        elseif v:IsA("Sky") then
            pcall(function() v.Parent = nil end)
        end
    end)
end

ToggleFPSBooster = function(enabled)
    FPSBoosterEnabled = enabled
    if enabled then
        ApplyFPSBooster()
        MonitorForNewAssets()
    else
        if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
        DisableFPSBooster()
    end
end

-- ============================================
--  PREDICTION ENGINE (Velocity division based)
-- ============================================

-- Per-player data storage
local PlayerPredictionData = {}

local function getPlayerData(player)
    if not PlayerPredictionData[player] then
        PlayerPredictionData[player] = {
            lastVelocity = Vector3.zero,
            lastTime = tick(),
        }
    end
    return PlayerPredictionData[player]
end

function predictPositionWithDivision(targetPart, myPosition, velDivX, velDivY)
    if not targetPart then return targetPart and targetPart.Position or Vector3.new() end
    
    local player = nil
    local character = targetPart.Parent
    if character and character:IsA("Model") then
        player = Players:GetPlayerFromCharacter(character)
    end
    
    local data = getPlayerData(player)
    local currentTime = tick()
    local dt = math.min(0.1, currentTime - data.lastTime)
    data.lastTime = currentTime

    local position = targetPart.Position
    local currentVelocity = targetPart.AssemblyLinearVelocity or Vector3.zero

    -- Smooth velocity (fixed smoothing for stability)
    local SMOOTHING = 0.3
    data.lastVelocity = data.lastVelocity:Lerp(currentVelocity, SMOOTHING)

    -- Apply velocity division per axis
    local dividedVelocity = Vector3.new(
        data.lastVelocity.X / velDivX,
        data.lastVelocity.Y / velDivY,
        data.lastVelocity.Z / velDivX
    )
    
    -- Fixed prediction time (0.05 seconds)
    local predictionTime = 0.05
    
    -- Predicted position = current + (divided velocity * time)
    local predictedPosition = position + (dividedVelocity * predictionTime)
    
    -- Keep Y axis within reasonable bounds
    predictedPosition = Vector3.new(
        predictedPosition.X,
        math.clamp(predictedPosition.Y, position.Y - 3, position.Y + 4),
        predictedPosition.Z
    )
    
    return predictedPosition
end

