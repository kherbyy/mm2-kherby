        local hrp = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        if not hrp and not head then
            esp.box.Visible = false
            esp.boxoutline.Visible = false
            return
        end
        
        local rootPart = hrp or head
        local position, onScreen = camera:WorldToViewportPoint(rootPart.Position)
        
        esp.box.Visible = onScreen
        esp.boxoutline.Visible = onScreen

        if onScreen then
            local scaleFactor = 1 / (position.Z * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000
            local width = math.round(4 * scaleFactor)
            local height = math.round(5 * scaleFactor)
            local x, y = math.round(position.X), math.round(position.Y)

            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = Vector2.new(math.round(x - width / 2), math.round(y - height / 2))
            esp.box.Color = getRoleColor(player)

            esp.boxoutline.Size = esp.box.Size
            esp.boxoutline.Position = esp.box.Position
        end
    else
        esp.box.Visible = false
        esp.boxoutline.Visible = false
    end
end

