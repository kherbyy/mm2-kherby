isMurdererFast = function(plr)
    if not plr then return false end
    local data = RoleCache[plr.Name]
    if data then return data.Role == "Murderer" end
    return false
end

isSheriffFast = function(plr)
    if not plr then return false end
    local data = RoleCache[plr.Name]
    if data then return data.Role == "Sheriff" end
    return false
end

isHeroFast = function(plr)
    if not plr then return false end
    local data = RoleCache[plr.Name]
    if data then return data.Role == "Hero" end
    if plr ~= LocalPlayer and isAliveFast(plr) then
        local hasGun = (plr.Backpack and (plr.Backpack:FindFirstChild("Gun") or plr.Backpack:FindFirstChild("Revolver"))) or
                       (plr.Character and (plr.Character:FindFirstChild("Gun") or plr.Character:FindFirstChild("Revolver")))
        if hasGun and not isMurdererFast(plr) and not isSheriffFast(plr) then
            return true
        end
    end
    return false
end

isAliveFast = function(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

isInnocentFast = function(plr)
    if plr == LocalPlayer then return false end
    if not isAliveFast(plr) then return false end
    local data = RoleCache[plr.Name]
    if data then 
        return data.Role == "Innocent" or data.Role == nil
    end
    return true
end

