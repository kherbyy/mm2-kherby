local function refreshESPForPlayer(plr)
    if not State.esp_enabled then return end
    if plr and plr.Character then
        CleanupESP(plr.Character)
        CreateESP(plr.Character, plr)
    end
    if State.box_esp_enabled and boxEspCache[plr] then
        boxEspCache[plr].box.Color = getRoleColor(plr)
    end
end

local function playerHasGun(plr)
    if not plr then return false end
    if plr.Character then
        if plr.Character:FindFirstChild("Gun") or plr.Character:FindFirstChild("Revolver") then
            return true
        end
    end
    if plr.Backpack then
        if plr.Backpack:FindFirstChild("Gun") or plr.Backpack:FindFirstChild("Revolver") then
            return true
        end
    end
    return false
end

local function updateHeroRole(plr)
    if not plr or plr == LocalPlayer then return end
    if isMurdererFast(plr) then return end
    
    local hasGun = playerHasGun(plr)
    
    if hasGun and not isSheriffFast(plr) then
        local currentRole = RoleCache[plr.Name] and RoleCache[plr.Name].Role
        if currentRole ~= "Hero" then
            RoleCache[plr.Name] = {
                Role = "Hero",
                Dead = false,
                Gun = true,
            }
            Notifier.new({Title="Hero Detected", Content=plr.Name.." is now HERO!", Duration=3})
            
            task.spawn(function()
                task.wait(0.1)
                refreshESPForPlayer(plr)
                if plr.Character then
                    local hl = plr.Character:FindFirstChild("MM2Highlight")
                    if hl then hl.FillColor = getRoleColor(plr) end
                    local tag = plr.Character:FindFirstChild("MM2NameTag")
                    if tag and tag:FindFirstChild("TextLabel") then
                        tag.TextLabel.TextColor3 = getRoleColor(plr)
                    end
                end
                if State.box_esp_enabled and boxEspCache[plr] then
                    boxEspCache[plr].box.Color = getRoleColor(plr)
                end
            end)
        end
    elseif not hasGun and not isMurdererFast(plr) and not isSheriffFast(plr) then
        local currentRole = RoleCache[plr.Name] and RoleCache[plr.Name].Role
        if currentRole == "Hero" then
            RoleCache[plr.Name] = {
                Role = "Innocent",
                Dead = false,
                Gun = false,
            }
            Notifier.new({Title="Role Update", Content=plr.Name.." dropped the gun, now INNOCENT", Duration=2})
            
            task.spawn(function()
                task.wait(0.1)
                refreshESPForPlayer(plr)
                if plr.Character then
                    local hl = plr.Character:FindFirstChild("MM2Highlight")
                    if hl then hl.FillColor = getRoleColor(plr) end
                end
                if State.box_esp_enabled and boxEspCache[plr] then
                    boxEspCache[plr].box.Color = getRoleColor(plr)
                end
            end)
        end
    end
end

local function monitorBackpack(plr)
    if plr == LocalPlayer then return end
    
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then
        backpack = plr:WaitForChild("Backpack", 10)
    end
    if not backpack then return end
    
    backpack.ChildAdded:Connect(function(tool)
        if tool and tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            task.wait(0.1)
            updateHeroRole(plr)
        end
    end)
    
    backpack.ChildRemoved:Connect(function(tool)
        if tool and tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            task.wait(0.1)
            updateHeroRole(plr)
        end
    end)
end

local function monitorCharacter(plr)
    if plr == LocalPlayer then return end
    
    local character = plr.Character
    if not character then return end
    
    character.ChildAdded:Connect(function(tool)
        if tool and tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            task.wait(0.1)
            if not isSheriffFast(plr) then
                local lastTime = lastPickupNotification[plr.Name] or 0
                if tick() - lastTime > PICKUP_COOLDOWN then
                    lastPickupNotification[plr.Name] = tick()
                    Notifier.new({Title="Gun Pickup", Content=plr.Name.." picked up the gun!", Duration=2})
                end
            end
            updateHeroRole(plr)
        end
    end)
    
    character.ChildRemoved:Connect(function(tool)
        if tool and tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then
            task.wait(0.1)
            updateHeroRole(plr)
        end
    end)
end

local function monitorGunDrop()
    local function checkGunDropRemoved()
        local gunDrop = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "GunDrop" then
                gunDrop = obj
                break
            end
        end
        
        if gunDrop then
            local connection
            connection = gunDrop.AncestryChanged:Connect(function()
                task.wait(0.3)
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and isAliveFast(plr) and not isMurdererFast(plr) and not isSheriffFast(plr) then
                        if playerHasGun(plr) then
                            updateHeroRole(plr)
                            if not isSheriffFast(plr) then
                                local lastTime = lastPickupNotification[plr.Name] or 0
                                if tick() - lastTime > PICKUP_COOLDOWN then
                                    lastPickupNotification[plr.Name] = tick()
                                    Notifier.new({Title="Gun Pickup", Content=plr.Name.." picked up the gun!", Duration=2})
                                end
                            end
                        end
                    end
                end
                if connection then connection:Disconnect() end
            end)
        end
    end
    
    task.spawn(function()
        while task.wait(0.5) do
            checkGunDropRemoved()
        end
    end)
end

