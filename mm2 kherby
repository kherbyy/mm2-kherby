local oldPrint = print
print = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    if msg:find("Container is not a valid member") then return end
    if msg:find("YourOffer") then return end
    if msg:find("TradeModule") then return end
    if msg:find("Line_211") then return end
    if msg:find("Line_251") then return end
    if msg:find("0, 0, 0") then return end
    if msg:find("Vector3") then return end
    oldPrint(...)
end

