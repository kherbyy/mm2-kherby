    local gun = character:FindFirstChild("Gun") or character:FindFirstChild("Revolver")
    if not gun then
        Notifier.new({Title="Flick Shoot", Content="No gun equipped", Duration=2})
        return
    end
    local isJumping = isPlayerJumping(targetPlr.Character)
