-- Hit part selection helper
local function getTargetPart(character, hitPart)
    if not character then return nil end
    if hitPart == "Head" then return character:FindFirstChild("Head") end
    if hitPart == "Torso" then return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart") end
    if hitPart == "LeftLeg" then return character:FindFirstChild("LeftLowerLeg") or character:FindFirstChild("LeftLeg") end
    if hitPart == "RightLeg" then return character:FindFirstChild("RightLowerLeg") or character:FindFirstChild("RightLeg") end
    if hitPart == "LeftArm" then return character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("LeftArm") end
    if hitPart == "RightArm" then return character:FindFirstChild("RightLowerArm") or character:FindFirstChild("RightArm") end
    if hitPart == "Closest" then
        local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.new()
        local closest, bestDist = nil, math.huge
        for _, partName in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LeftLowerLeg", "RightLowerLeg", "LeftLowerArm", "RightLowerArm"}) do
            local part = character:FindFirstChild(partName)
            if part then
                local dist = (part.Position - myPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    closest = part
                end
            end
        end
        return closest
    end
    -- default fallback
    return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
end

