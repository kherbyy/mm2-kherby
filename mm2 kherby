local function create2DTracer(color)
    local tracerLine = Drawing.new("Line")
    tracerLine.Thickness = 2
    tracerLine.Color = color
    tracerLine.Visible = true
    tracerLine.Transparency = 0.5
    tracerLine.ZIndex = 10
    return tracerLine
end

local function update2DTracer(tracer, targetPosition)
    if not tracer then return end
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    local fromPoint = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    local toPoint, onScreen = camera:WorldToViewportPoint(targetPosition)
    if onScreen then
        tracer.From = fromPoint
        tracer.To = Vector2.new(toPoint.X, toPoint.Y)
        tracer.Visible = true
    else
        tracer.Visible = false
    end
end

