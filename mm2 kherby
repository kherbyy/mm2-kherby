-- ===== FPS BOOSTER =====
FPSBoosterEnabled = false
DisabledAssets = {}

ApplyFPSBooster = function()
    if not FPSBoosterEnabled then return end
    for _, v in next, game:GetDescendants() do
        if v:IsA("Decal") or v:IsA("Texture") then
            pcall(function()
                if v.Texture ~= "" then
                    table.insert(DisabledAssets, {obj = v, prop = "Texture", value = v.Texture})
                    v.Texture = ""
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
            pcall(function()
                if v.Enabled then
                    table.insert(DisabledAssets, {obj = v, prop = "Enabled", value = true})
                    v.Enabled = false
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("Part") or v:IsA("Union") or v:IsA("BasePart") then
            pcall(function()
                if v.Material ~= Enum.Material.SmoothPlastic then
                    table.insert(DisabledAssets, {obj = v, prop = "Material", value = v.Material})
                    v.Material = Enum.Material.SmoothPlastic
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Explosion") or v:IsA("Sparkles") or v:IsA("Fire") then
            pcall(function()
                if v.Enabled then
                    table.insert(DisabledAssets, {obj = v, prop = "Enabled", value = true})
                    v.Enabled = false
                end
            end)
        end
    end
    for _, v in next, game:GetDescendants() do
        if v:IsA("Sky") then
            pcall(function()
                table.insert(DisabledAssets, {obj = v, prop = "Parent", value = v.Parent})
                v.Parent = nil
            end)
        end
    end
end

DisableFPSBooster = function()
    for _, asset in ipairs(DisabledAssets) do
        pcall(function()
            if asset.obj then
                if asset.prop == "Parent" then
                    if asset.value then asset.obj.Parent = asset.value end
                else
                    asset.obj[asset.prop] = asset.value
                end
            end
        end)
    end
    DisabledAssets = {}
end

descendantConnection = nil
MonitorForNewAssets = function()
    if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
    if not FPSBoosterEnabled then return end
    descendantConnection = game.DescendantAdded:Connect(function(v)
        if not FPSBoosterEnabled then return end
        task.wait(0.1)
        if v:IsA("Decal") or v:IsA("Texture") then
            pcall(function() v.Texture = "" end)
        elseif v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
            pcall(function() v.Enabled = false end)
        elseif v:IsA("Part") or v:IsA("Union") or v:IsA("BasePart") then
            pcall(function() v.Material = Enum.Material.SmoothPlastic end)
        elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Explosion") or v:IsA("Sparkles") or v:IsA("Fire") then
            pcall(function() v.Enabled = false end)
        elseif v:IsA("Sky") then
            pcall(function() v.Parent = nil end)
        end
    end)
end

ToggleFPSBooster = function(enabled)
    FPSBoosterEnabled = enabled
    if enabled then
        ApplyFPSBooster()
        MonitorForNewAssets()
    else
        if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
        DisableFPSBooster()
    end
end

-- ===== ENHANCED PREDICTION SYSTEM (WORKS FOR FAST + NORMAL MOVEMENT) =====
PredictionSystem = {playerData = {}, gravity = workspace.Gravity}
NetworkMetrics = {
    ping = 0, variance = 0, jitter = 0, standardDeviation = 0,
    lastUpdate = 0, history = {}, maxHistory = 200,
    RTTBuffer = 0, packetLoss = 0, stability = 1.0,
}

getNetworkPing = function()
    local ping = 0
    pcall(function() ping = LocalPlayer:GetNetworkPing() * 1000 end)
    if ping == 0 then
        local stats = Stats.Network.ServerStatsItem["Data Ping"]
        if stats then ping = tonumber(stats:GetValueString():match("%d+")) or 0 end
    end
    return math.clamp(ping, 2, 500)
end

calculateStandardDeviation = function(data)
    if #data < 2 then return 0 end
    local sum = 0 for _, v in ipairs(data) do sum = sum + v end
    local mean = sum / #data
    local varianceSum = 0 for _, v in ipairs(data) do varianceSum = varianceSum + (v - mean) ^ 2 end
    return math.sqrt(varianceSum / #data)
end

updateNetworkMetrics = function()
    local currentTime = tick()
    if currentTime - NetworkMetrics.lastUpdate < 0.1 then return end
    local rawPing = getNetworkPing()
    table.insert(NetworkMetrics.history, 1, rawPing)
    if #NetworkMetrics.history > NetworkMetrics.maxHistory then table.remove(NetworkMetrics.history) end
    if #NetworkMetrics.history >= 30 then
        local recentPings = {}
        for i = 1, math.min(50, #NetworkMetrics.history) do table.insert(recentPings, NetworkMetrics.history[i]) end
        local sum = 0 for _, p in ipairs(recentPings) do sum = sum + p end
        local avgPing = sum / #recentPings
        NetworkMetrics.standardDeviation = calculateStandardDeviation(recentPings)
        NetworkMetrics.variance = NetworkMetrics.standardDeviation ^ 2
        NetworkMetrics.jitter = NetworkMetrics.standardDeviation * 0.6
        NetworkMetrics.ping = avgPing
        local stableCount = 0
        for _, p in ipairs(recentPings) do if math.abs(p - avgPing) < NetworkMetrics.standardDeviation * 1.5 then stableCount = stableCount + 1 end end
        NetworkMetrics.stability = stableCount / #recentPings
        NetworkMetrics.RTTBuffer = (NetworkMetrics.ping + NetworkMetrics.jitter * 1.2) / 1000
    else
        NetworkMetrics.ping = rawPing
        NetworkMetrics.RTTBuffer = rawPing / 1000
        NetworkMetrics.stability = 0.5
    end
    NetworkMetrics.lastUpdate = currentTime
end

initPlayerData = function(player)
    if not PredictionSystem.playerData[player] then
        PredictionSystem.playerData[player] = {
            lastPosition = Vector3.new(), lastVelocity = Vector3.new(), lastTime = tick(),
            positionHistory = {}, velocityHistory = {}, directionHistory = {},
            lastTargetPart = "UpperTorso", wasJumping = false, strafeDirection = 0, lastStrafeTime = 0,
            acceleration = Vector3.new(), lastVelMagnitude = 0, isFlying = false, flyingTime = 0,
            maxVelocity = 0, speedHackDetected = false,
        }
    end
    return PredictionSystem.playerData[player]
end

isPlayerJumping = function(character)
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        local velocityY = rootPart.AssemblyLinearVelocity and rootPart.AssemblyLinearVelocity.Y or 0
        return velocityY > 5 and humanoid.FloorMaterial == Enum.Material.Air
    end
    return false
end

detectFlyingOrSpeedhack = function(data, currentVel, gravity)
    local velMagnitude = currentVel.Magnitude
    local velDelta = velMagnitude - data.lastVelMagnitude
    if velMagnitude > data.maxVelocity then data.maxVelocity = velMagnitude end
    local normalMaxAccel = gravity * 5
    local detectedAccel = math.abs(velDelta)
    if detectedAccel > normalMaxAccel * 2 and velMagnitude > 50 then
        data.speedHackDetected = true
    else
        data.speedHackDetected = false
    end
    local velocityY = currentVel.Y
    if velocityY > 10 and not isPlayerJumping then
        data.flyingTime = data.flyingTime + 0.016
        if data.flyingTime > 0.2 then data.isFlying = true end
    else
        data.flyingTime = 0
        data.isFlying = false
    end
    if #data.velocityHistory > 0 then
        local timeDelta = 0.016
        data.acceleration = (currentVel - data.lastVelocity) / timeDelta
    end
end

detectStrafeDirection = function(player, currentVel)
    local data = initPlayerData(player)
    if #data.velocityHistory < 3 then return 0 end
    local prevVel = data.velocityHistory[#data.velocityHistory - 1]
    if not prevVel then return 0 end
    local currentHoriz = Vector3.new(currentVel.X, 0, currentVel.Z)
    local prevHoriz = Vector3.new(prevVel.vel.X, 0, prevVel.vel.Z)
    if currentHoriz.Magnitude < 5 or prevHoriz.Magnitude < 5 then return 0 end
    local currentDir = currentHoriz.Unit
    local prevDir = prevHoriz.Unit
    local crossY = prevDir.X * currentDir.Z - prevDir.Z * currentDir.X
    local strafeDirection = crossY > 0.1 and 1 or (crossY < -0.1 and -1 or 0)
    if strafeDirection ~= 0 and strafeDirection ~= data.strafeDirection then data.lastStrafeTime = tick() end
    data.strafeDirection = strafeDirection
    return strafeDirection
end

local function getAvatarScale(character)
    if not character then return 1 end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local scale = hrp.Size.Y / 2
            if scale > 0.5 and scale < 1.5 then
                return math.clamp(scale, 0.6, 1.2)
            end
        end
    end
    return 1
end

local function getBestHitboxPart(character, isAirborne)
    if not character then return nil end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local upperTorso = character:FindFirstChild("UpperTorso")
    local lowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("HumanoidRootPart")
    local avatarScale = getAvatarScale(character)
    
    if avatarScale < 0.8 then
        return upperTorso or lowerTorso or hrp or head
    end
    
    if isAirborne then
        return upperTorso or lowerTorso or hrp or head
    else
        return upperTorso or lowerTorso or head or hrp
    end
end

-- MAIN PREDICTION FUNCTION - OPTIMIZED FOR FAST + NORMAL MOVEMENT
predictPlayerPosition = function(player, targetPart)
    if not player or not player.Character then return targetPart and targetPart.Position or Vector3.new() end
    local character = player.Character
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return targetPart and targetPart.Position or Vector3.new() end
    
    updateNetworkMetrics()
    local data = initPlayerData(player)
    local currentTime = tick()
    local currentPos = hrp.Position
    local currentVel = hrp.Velocity
    local gravity = PredictionSystem.gravity
    
    detectFlyingOrSpeedhack(data, currentVel, gravity)
    
    table.insert(data.positionHistory, 1, {pos = currentPos, time = currentTime})
    if #data.positionHistory > 20 then table.remove(data.positionHistory) end
    table.insert(data.velocityHistory, 1, {vel = currentVel, time = currentTime})
    if #data.velocityHistory > 20 then table.remove(data.velocityHistory) end
    
    if currentVel.Magnitude > 1 then
        local currentDir = currentVel.Unit
        table.insert(data.directionHistory, 1, currentDir)
        if #data.directionHistory > 15 then table.remove(data.directionHistory) end
    end
    
    data.lastPosition = currentPos
    data.lastVelocity = currentVel
    data.lastTime = currentTime
    data.lastVelMagnitude = currentVel.Magnitude
    
    local isJumping = isPlayerJumping(character)
    local avatarScale = getAvatarScale(character)
    
    local chosenPart = targetPart or getBestHitboxPart(character, isJumping)
    if not chosenPart then chosenPart = hrp end
    
    local targetPos = chosenPart.Position
    local velocity = chosenPart.AssemblyLinearVelocity or Vector3.new()
    local speed = velocity.Magnitude
    
    -- DYNAMIC PREDICTION TIME - ADAPTS TO SPEED
    local basePrediction = math.clamp(NetworkMetrics.RTTBuffer + 0.03, 0.025, 0.1)
    local speedBonus = 0
    
    -- FAST MOVEMENT COMPENSATION (for speed hackers and runners)
    if data.speedHackDetected or speed > 40 then
        speedBonus = math.min(speed / 800, 0.12)
        basePrediction = basePrediction + 0.05
    elseif speed > 25 then
        speedBonus = math.min(speed / 1200, 0.08)
        basePrediction = basePrediction + 0.03
    elseif speed > 16 then
        speedBonus = math.min(speed / 2000, 0.05)
        basePrediction = basePrediction + 0.015
    else
        -- NORMAL MOVEMENT (walking)
        speedBonus = math.min(speed / 3000, 0.03)
    end
    
    -- Flying detection bonus
    if data.isFlying then
        speedBonus = math.min(velocity.Magnitude / 1500, 0.1)
        basePrediction = basePrediction + 0.04
    end
    
    -- Hitbox abuser compensation
    if avatarScale < 0.8 then
        local hitboxCompensation = (0.8 - avatarScale) * 0.08
        basePrediction = basePrediction + math.min(hitboxCompensation, 0.04)
    end
    
    local predictionTime = math.clamp(basePrediction + speedBonus, 0.025, 0.18)
    local predictedPos = targetPos + (velocity * predictionTime)
    
    -- ENHANCED JUMP TRAJECTORY (works for both small and big jumps)
    if isJumping or math.abs(velocity.Y) > 4 then
        local verticalVelocity = velocity.Y
        local verticalOffset = (verticalVelocity * predictionTime) - (0.5 * gravity * predictionTime * predictionTime)
        
        -- Adjust for different jump heights
        if verticalVelocity < -3 then
            verticalOffset = verticalOffset - (gravity * predictionTime * predictionTime * 0.25)
        elseif verticalVelocity > 3 then
            verticalOffset = verticalOffset + (verticalVelocity * predictionTime * 0.15)
        end
        
        -- Small avatar compensation
        if avatarScale < 0.8 then
            verticalOffset = verticalOffset + (avatarScale * 0.3)
        end
        
        predictedPos = Vector3.new(predictedPos.X, targetPos.Y + verticalOffset, predictedPos.Z)
        
        -- Horizontal movement during jumps (important for fast players)
        if speed > 12 then
            local horizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
            local horizontalMult = 1.05
            if speed > 30 then horizontalMult = 1.15 end
            local horizontalPrediction = horizontalVel * predictionTime * horizontalMult
            predictedPos = Vector3.new(predictedPos.X + horizontalPrediction.X, predictedPos.Y, predictedPos.Z + horizontalPrediction.Z)
        end
    end
    
    -- STRAFE DETECTION (for AD-spammers)
    local strafeDirection = detectStrafeDirection(player, velocity)
    local isStrafing = math.abs(strafeDirection) > 0
    
    if isStrafing and speed > 10 and not isJumping then
        local strafeStrength = math.min(speed / 40, 1.5)
        if strafeDirection > 0 then
            predictedPos = predictedPos + (chosenPart.CFrame.RightVector * strafeStrength * 0.35)
        elseif strafeDirection < 0 then
            predictedPos = predictedPos - (chosenPart.CFrame.RightVector * strafeStrength * 0.35)
        end
    end
    
    -- ZIGZAG DETECTION (for unpredictable movement)
    if #data.directionHistory >= 5 then
        local directionChanges = 0
        for i = 2, math.min(5, #data.directionHistory) do 
            if data.directionHistory[i-1]:Dot(data.directionHistory[i]) < 0.5 then 
                directionChanges = directionChanges + 1 
            end 
        end
        if directionChanges >= 2 then
            local zigzagFactor = math.sin(tick() * 18) * 0.25
            if speed > 20 then zigzagFactor = zigzagFactor * 1.2 end
            predictedPos = predictedPos + (chosenPart.CFrame.RightVector * zigzagFactor * 0.35)
        end
    end
    
    -- VELOCITY SMOOTHING (prevents jitter on fast targets)
    if #data.velocityHistory >= 2 then
        local avgVelX, avgVelZ, weightSum = 0, 0, 0
        for i = 1, math.min(3, #data.velocityHistory) do
            local weight = 1 / i
            avgVelX = avgVelX + data.velocityHistory[i].vel.X * weight
            avgVelZ = avgVelZ + data.velocityHistory[i].vel.Z * weight
            weightSum = weightSum + weight
        end
        if weightSum > 0 then
            avgVelX = avgVelX / weightSum
            avgVelZ = avgVelZ / weightSum
            local smoothWeight = 0.75
            if speed > 30 then smoothWeight = 0.85 end
            local smoothedVel = Vector3.new(avgVelX, velocity.Y * 0.5, avgVelZ)
            local smoothedPos = targetPos + (smoothedVel * predictionTime * 0.4)
            predictedPos = predictedPos * smoothWeight + smoothedPos * (1 - smoothWeight)
        end
    end
    
    -- SMALL AVATAR SPREAD (hitbox abusers)
    if avatarScale < 0.85 then
        local spreadAmount = (0.85 - avatarScale) * 0.6
        if spreadAmount > 0 then
            local angle = tick() * 12
            local xOffset = math.sin(angle) * spreadAmount
            local zOffset = math.cos(angle * 0.7) * spreadAmount
            predictedPos = Vector3.new(predictedPos.X + xOffset, predictedPos.Y, predictedPos.Z + zOffset)
        end
    end
    
    -- SANITY CHECKS
    local lowestPoint = targetPos.Y - 3.5
    if avatarScale < 0.8 then
        lowestPoint = targetPos.Y - (3.5 * avatarScale)
    end
    if predictedPos.Y < lowestPoint then
        predictedPos = Vector3.new(predictedPos.X, lowestPoint, predictedPos.Z)
    end
    
    -- Don't predict too high (prevents flying predictions)
    local highestPoint = targetPos.Y + 15
    if predictedPos.Y > highestPoint then
        predictedPos = Vector3.new(predictedPos.X, highestPoint, predictedPos.Z)
    end
    
    predictedPos = Vector3.new(
        predictedPos.X,
        math.clamp(predictedPos.Y, -50, 500),
        predictedPos.Z
    )
    
    return predictedPos
end

