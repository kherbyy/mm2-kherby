local function isMurderer(plr)
    if not plr then return false end
    return (plr.Backpack:FindFirstChild("Knife") or (plr.Character and plr.Character:FindFirstChild("Knife")))
end

local function isAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end

local function isSheriff(plr)
    if not plr then return false end
    local gunNames = {"Gun", "Revolver"}
    for _, name in ipairs(gunNames) do
        if plr.Backpack:FindFirstChild(name) or (plr.Character and plr.Character:FindFirstChild(name)) then
            return true
        end
    end
    return false
end

-- ULTRA-ACCURATE Murderer position tracking
local function getMurdererPosition()
    local bestMurderer = nil
    local bestPart = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) and isMurderer(plr) then
            local character = plr.Character
            
            -- Priority: Head > HumanoidRootPart for maximum accuracy
            local head = character:FindFirstChild("Head")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            
            if head then
                -- Head shot is most accurate
                return head.Position
            elseif hrp then
                -- Fallback to body
                bestMurderer = hrp.Position
                bestPart = hrp
            end
        end
    end
    
    return bestMurderer, bestPart
end

-- Enhanced prediction for moving targets
local function getPredictedMurdererPosition()
    local murdererPos, murdererPart = getMurdererPosition()
    if not murdererPos then return nil end
    
    if predictionEnabled and murdererPart then
        -- Get the murderer's HumanoidRootPart for velocity data
        local character = murdererPart.Parent
        if character then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Velocity and hrp.Velocity.Magnitude > 3 then
                -- Calculate lead based on distance and velocity
                local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myPos then
                    local distance = (murdererPos - myPos.Position).Magnitude
                    -- Dynamic prediction: more lead for farther targets
                    local dynamicPrediction = predictionAmount * (1 + (distance / 200))
                    murdererPos = murdererPos + (hrp.Velocity * dynamicPrediction)
                else
                    murdererPos = murdererPos + (hrp.Velocity * predictionAmount)
                end
            end
        end
    end
    
    return murdererPos
end

local function setupSilentAim()
    WeaponService = getWeaponService()
    if WeaponService and WeaponService.GetMouseTargetCFrame then
        originalGetTarget = WeaponService.GetMouseTargetCFrame
        
        WeaponService.GetMouseTargetCFrame = function(self)
            if silentAimEnabled then
                if aimOnlyWhenHolding then
                    if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then
                        return originalGetTarget(self)
                    end
                end
                
                local murdererPos = getPredictedMurdererPosition()
                if murdererPos then
                    silentAimActive = true
                    -- Return exact murderer position for 100% accuracy
                    return CFrame.new(murdererPos)
                else
                    silentAimActive = false
                end
            end
            return originalGetTarget(self)
        end
        
        -- Silent notification on load
        Rayfield:Notify({
            Title = "Silent Aim Ready",
            Content = "WeaponService hooked successfully",
            Duration = 2
        })
    end
end

