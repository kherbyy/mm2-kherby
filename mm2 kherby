        UpdateAllHitboxes()
        Notifier.new({Title="Hitbox Visuals", Content=State.hitbox_viz and "ON" or "OFF", Duration=2})
    elseif input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.Plus then
