-- ===== KEYBINDS =====
UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if i.UserInputType==Enum.UserInputType.MouseButton2 then holdingM2=State.Aim.e and State.Aim.a
    elseif i.KeyCode==toKey(State.Hit.vk) then 
        State.Hit.viz = not State.Hit.viz
        UpdateAllHitboxes()
        Notifier.new({Title="Hitbox Visuals", Content=State.Hit.viz and "ON" or "OFF", Duration=2})
    elseif i.KeyCode==Enum.KeyCode.Equals or i.KeyCode==Enum.KeyCode.Plus then 
        State.Hit.sz = math.min(State.Hit.sz + 5, 50)
        if State.Hit.e then UpdateAllHitboxes() end
        Notifier.new({Title="Hitbox Size", Content=tostring(State.Hit.sz), Duration=1.5})
    elseif i.KeyCode==Enum.KeyCode.Minus then 
        State.Hit.sz = math.max(State.Hit.sz - 5, 5)
        if State.Hit.e then UpdateAllHitboxes() end
        Notifier.new({Title="Hitbox Size", Content=tostring(State.Hit.sz), Duration=1.5})
    elseif i.KeyCode==toKey(State.God.kb) then 
        if not State.God.e then Notifier.new({Title="God Mode", Content="Enable in UI first", Duration=3}) return end 
        State.God.e = not State.God.e 
        if State.God.e then EnableGod() end
    elseif i.KeyCode==toKey(State.Aim.kb) then 
        if not State.Aim.e then Notifier.new({Title="Aimbot", Content="Enable in UI first", Duration=3}) return end 
        State.Aim.a = not State.Aim.a 
        if not State.Aim.a then lockedTarget = nil lastLocked = nil end
    elseif i.KeyCode==toKey(State.Flick.kb) then 
        if not State.Flick.e then Notifier.new({Title="Flick Shoot", Content="Enable in UI first", Duration=3}) return end 
        local target = nil 
        for _,p in ipairs(Players:GetPlayers()) do 
            if p~=LocalPlayer and isAlive(p) then 
                if State.Flick.om and not isMurderer(p) then continue end 
                if p.Character then target=p break end 
            end 
        end 
        if target and target.Character then 
            local g = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Character:FindFirstChild("Revolver")) 
            if g then 
                local isJump = IsJumping(target.Character) 
                local part = isJump and target.Character:FindFirstChild("HumanoidRootPart") or (target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("Torso")) or target.Character:FindFirstChild("HumanoidRootPart") 
                if part then 
                    local pos = PredictPos(target, part) 
                    local cam = WS.CurrentCamera 
                    local start = cam.CFrame 
                    local targetCF = CFrame.new(cam.CFrame.Position, pos) 
                    local st = tick() 
                    while tick()-st < 0.12 do 
                        cam.CFrame = start:Lerp(targetCF, (tick()-st)/0.12) 
                        RunS.RenderStepped:Wait() 
                    end 
                    cam.CFrame = targetCF 
                    task.wait(0.05) 
                    g:Activate() 
                end 
            end 
        end
    elseif i.KeyCode==toKey(State.Desync.kb) then 
        if not State.Desync.e then Notifier.new({Title="Desync", Content="Enable in UI first", Duration=3}) return end 
        State.Desync.a = not State.Desync.a 
        getgenv().Desync.Enabled = State.Desync.a 
        if not State.Desync.a then getgenv().Desync.AvoidActive = false end
    elseif i.KeyCode==toKey(State.Kill.kb) then 
        if not State.Kill.e then Notifier.new({Title="Kill All", Content="Enable Kill Aura first", Duration=3}) return end 
        KillAll() 
    end
end)

