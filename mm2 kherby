local function TeleportToGunSnapBack()
    if isMurderer(LocalPlayer) then
        Notifier.new({Title="Auto TP Skipped", Content="You're the murderer - keeping your knife!", Duration=2})
        return
    end
    
    local currentMap = getCurrentMap()
    local gunDrop = Workspace:FindFirstChild("GunDrop")
    if currentMap and not gunDrop then gunDrop = currentMap:FindFirstChild("GunDrop") end
    
    if not gunDrop then
        Notifier.new({Title="Gun TP", Content="No Gun Dropped", Duration=2.5})
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    State.Teleport.LastGunPos = char.HumanoidRootPart.CFrame
    Notifier.new({Title="Gun TP", Content="Snapping to gun...", Duration=1.5})
    
    task.spawn(function()
        local timeout = tick()
        while (tick() - timeout) < 2 and gunDrop and gunDrop.Parent do
