local function SetupPlayerESP(plr)
    if plr == LocalPlayer then return end
    
    local backpack = plr:WaitForChild("Backpack")
    
    local function OnToolChange()
        task.wait(0.08)
        if State.ESP.Enabled and plr.Character and isAlive(plr) then
            CreateESP(plr.Character, plr)
        else
            UpdateAllESPColors()
        end
    end
    
    backpack.ChildAdded:Connect(function(c)
        if c and (c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver") then OnToolChange() end
    end)
    backpack.ChildRemoved:Connect(function(c)
        if c and (c.Name == "Knife" or c.Name == "Gun" or c.Name == "Revolver") then OnToolChange() end
    end)
    
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.85)
        if State.ESP.Enabled and char and char.Parent then CreateESP(char, plr) end
    end)
    plr.CharacterRemoving:Connect(CleanupESP)
    
    if plr.Character then
        task.spawn(function()
            task.wait(1.2)
            if State.ESP.Enabled and plr.Character and plr.Character.Parent then 
                CreateESP(plr.Character, plr) 
            end
        end)
    end
end

