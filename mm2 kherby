findLobby = function()
    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then return lobby end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "Spawns" and v.Parent and v.Parent.Name == "Lobby" then return v.Parent end
    end
    return nil
end

getSpawnPoint = function(location)
    if not location then return nil end
    local spawns = location:FindFirstChild("Spawns")
    if spawns then
        for _, child in ipairs(spawns:GetChildren()) do if child:IsA("BasePart") then return child end end
    end
    for _, child in ipairs(location:GetChildren()) do if child:IsA("BasePart") then return child end end
    return nil
end

tpLobby = function()
