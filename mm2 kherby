SkidFling = function(TargetPlayer, callback)
    if getgenv().FlingActive and getgenv().FlingTarget then return end
    getgenv().FlingActive = true
    getgenv().FlingTarget = TargetPlayer
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    local THumanoid, TRootPart, THead, Accessory, Handle
    if not Character or not Humanoid or not RootPart then
        Notifier.new({Title="Fling Error", Content="Your character not loaded", Duration=3})
        getgenv().FlingActive = false getgenv().FlingTarget = nil if callback then callback() end return
    end
    if TCharacter then
        THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
        if THumanoid and THumanoid.RootPart then TRootPart = THumanoid.RootPart end
        THead = TCharacter:FindFirstChild("Head")
        Accessory = TCharacter:FindFirstChildOfClass("Accessory")
        if Accessory and Accessory:FindFirstChild("Handle") then Handle = Accessory.Handle end
    end
    if not (TCharacter and THumanoid) then
        Notifier.new({Title="Fling Error", Content="Target not loaded", Duration=3})
        getgenv().FlingActive = false getgenv().FlingTarget = nil if callback then callback() end return
    end
    if THumanoid.Sit then
        Notifier.new({Title="Fling Error", Content="Target is sitting", Duration=3})
        getgenv().FlingActive = false getgenv().FlingTarget = nil if callback then callback() end return
    end
    getgenv().OldPos = RootPart.CFrame
    if THead then workspace.CurrentCamera.CameraSubject = THead
    elseif Handle then workspace.CurrentCamera.CameraSubject = Handle
    elseif THumanoid and TRootPart then workspace.CurrentCamera.CameraSubject = THumanoid end
    local oldAntiFling = State.antifling_enabled
    State.antifling_enabled = false
    workspace.FallenPartsDestroyHeight = 0/0
    local BV = Instance.new("BodyVelocity")
    BV.Name = "EpixVel"
    BV.Parent = RootPart
    BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
    BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    local targetPart = THead or TRootPart or Handle or TRootPart
    if not targetPart then
        Notifier.new({Title="Fling Error", Content="Target has no flingable parts", Duration=3})
        BV:Destroy()
        getgenv().FlingActive = false getgenv().FlingTarget = nil if callback then callback() end return
    end
    local function FPos(BasePart, Pos, Ang)
        RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
        Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end
    local function SFBasePart(BasePart)
        local TimeToWait = 3
        local Time = tick()
        local Angle = 0
        Notifier.new({Title="Fling Started", Content="Flinging "..TargetPlayer.Name, Duration=2})
        repeat
            if RootPart and THumanoid then
                if BasePart.Velocity.Magnitude < 50 then
                    Angle = Angle + 100
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle),0 ,0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(2.25, 1.5, -2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(-2.25, -1.5, 2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection,CFrame.Angles(math.rad(Angle), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection,CFrame.Angles(math.rad(Angle), 0, 0)) task.wait()
                else
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, -TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, TRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5 ,0), CFrame.Angles(math.rad(-90), 0, 0)) task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0)) task.wait()
                end
            else break end
        until BasePart.Velocity.Magnitude > 500 or not BasePart.Parent or TargetPlayer.Parent ~= Players or THumanoid.Sit or Humanoid.Health <= 0 or tick() > Time + TimeToWait
    end
    if TRootPart and THead then
        if (TRootPart.Position - THead.Position).Magnitude > 5 then SFBasePart(THead) else SFBasePart(TRootPart) end
    elseif TRootPart then SFBasePart(TRootPart)
    elseif THead then SFBasePart(THead)
    elseif Handle then SFBasePart(Handle) end
    pcall(BV.Destroy, BV)
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = Humanoid
    State.antifling_enabled = oldAntiFling
    workspace.FallenPartsDestroyHeight = getgenv().FPDH
    local returnStart = tick()
    repeat
        pcall(function()
            RootPart.CFrame = getgenv().OldPos * CFrame.new(0, .5, 0)
            Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, .5, 0))
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            for _, x in ipairs(Character:GetDescendants()) do if x:IsA("BasePart") then x.Velocity = Vector3.new() x.RotVelocity = Vector3.new() end end
        end)
        task.wait(0.1)
    until (RootPart.Position - getgenv().OldPos.Position).Magnitude < 25 or tick() - returnStart > 2
    Notifier.new({Title="Fling Success", Content="Successfully flung "..TargetPlayer.Name, Duration=3})
    getgenv().FlingActive = false
    getgenv().FlingTarget = nil
    if callback then callback() end
end

-- ===== AUTO FARM =====
AutoFarm = { isCollecting = false, coinsList = {}, coinHighlights = {}, isWaitingForNewCoins = false, tweenSpeed = 0.8 }

isCoin = function(part)
    if not part or not part:IsA("BasePart") then return false end
    if not part.Name then return false end
    local nameLower = part.Name:lower()
    return nameLower:find("coin") or nameLower:find("pickup") or nameLower:find("cash") or nameLower:find("money")
end

scanForCoins = function()
    local coins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCoin(obj) then table.insert(coins, { part = obj, position = obj.Position, name = obj.Name, distance = 0 }) end
    end
    return coins
end

highlightCoin = function(coin)
    if not coin or not coin:IsA("BasePart") then return end
    if AutoFarm.coinHighlights[coin] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "AutoFarmCoinHighlight"
    hl.Adornee = coin
    hl.FillColor = Color3.fromRGB(255, 215, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.3
    hl.Parent = coin
    AutoFarm.coinHighlights[coin] = hl
end

clearCoinHighlights = function()
    for coin, hl in pairs(AutoFarm.coinHighlights) do pcall(function() hl:Destroy() end) end
    AutoFarm.coinHighlights = {}
end

refreshCoinESP = function()
    if not State.autofarm_esp then clearCoinHighlights() return end
    for _, obj in ipairs(workspace:GetDescendants()) do if isCoin(obj) then highlightCoin(obj) end end
end

sortCoinsByDistance = function(coins, currentPos)
    for _, coin in ipairs(coins) do coin.distance = (currentPos - coin.position).Magnitude end
    table.sort(coins, function(a, b) return a.distance < b.distance end)
    return coins
end

desyncCollect = function(targetPos)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    local originalPos = rootPart.CFrame
    rootPart.CFrame = CFrame.new(targetPos.X, targetPos.Y + 2, targetPos.Z)
    task.wait(0.15)
    rootPart.CFrame = originalPos
    return true
end

tweenCollect = function(targetPos)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    local targetCFrame = CFrame.new(targetPos.X, targetPos.Y + 2, targetPos.Z)
    local tweenInfo = TweenInfo.new(State.autofarm_tween_speed, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    task.wait(0.1)
    return true
end

startAutoFarm = function()
    if AutoFarm.isCollecting then return end
    AutoFarm.isCollecting = true
    AutoFarm.isWaitingForNewCoins = false
    while State.autofarm_enabled do
        local allCoins = scanForCoins()
        if #allCoins == 0 then
            if not AutoFarm.isWaitingForNewCoins then AutoFarm.isWaitingForNewCoins = true end
            task.wait(1)
        else
            AutoFarm.isWaitingForNewCoins = false
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if not rootPart then task.wait(0.5)
            else
                local sortedCoins = sortCoinsByDistance(allCoins, rootPart.Position)
                for i, coin in ipairs(sortedCoins) do
                    if not State.autofarm_enabled then break end
                    if not coin.part or not coin.part.Parent then break end
                    if coin.part then
                        local tempHighlight = Instance.new("Highlight")
                        tempHighlight.Adornee = coin.part
                        tempHighlight.FillColor = Color3.fromRGB(255, 50, 50)
                        tempHighlight.FillTransparency = 0.2
                        tempHighlight.Parent = coin.part
                        task.delay(0.3, function() pcall(function() tempHighlight:Destroy() end) end)
                    end
                    if State.autofarm_mode == "DESYNC" then desyncCollect(coin.position) task.wait(1.5)
                    else tweenCollect(coin.position) end
                    refreshCoinESP()
                end
                task.wait(0.3)
            end
        end
    end
    AutoFarm.isCollecting = false
end

toggleAutoFarm = function()
    State.autofarm_enabled = not State.autofarm_enabled
    if State.autofarm_enabled then refreshCoinESP() task.spawn(startAutoFarm)
    else AutoFarm.isCollecting = false clearCoinHighlights() end
end

toggleAutoFarmESP = function()
    State.autofarm_esp = not State.autofarm_esp
    if State.autofarm_esp then refreshCoinESP() else clearCoinHighlights() end
end

setAutoFarmMode = function(mode) State.autofarm_mode = mode end
setTweenSpeed = function(speed) State.autofarm_tween_speed = 0.3 + (speed / 100) * 2.7 end

