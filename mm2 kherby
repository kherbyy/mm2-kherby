local function GetBestTarget()
    if not State.Aim.e or not State.Aim.a then return nil end
    if State.Aim.s and lockedTarget and isAlive(lockedTarget) then return lockedTarget end
    local cam=WS.CurrentCamera
    local mPos=UIS:GetMouseLocation()
    local best,bScore=nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isAlive(p) and p.Character then
            if State.Aim.om and not isMurderer(p) then continue end
            local isJump=IsJumping(p.Character)
            local part=isJump and p.Character:FindFirstChild("HumanoidRootPart") or (p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")) or p.Character:FindFirstChild("Head")
            if part then
                local sp,on=cam:WorldToViewportPoint(part.Position)
                if on then
                    local dist=(Vector2.new(sp.X,sp.Y)-mPos).Magnitude
                    if dist<State.Aim.fov then
                        local score=isMurderer(p) and dist*0.15 or dist
                        if score<bScore then bScore=score best=p end
                    end
                end
            end
        end
    end
    if State.Aim.s and best then lockedTarget=best end
    return best
end

local function UpdateAimbot()
    if not State.Aim.e or not State.Aim.a or not holdingM2 then return end
    local target=GetBestTarget()
    if not target or not target.Character then return end
    local isJump=IsJumping(target.Character)
    local part=isJump and target.Character:FindFirstChild("HumanoidRootPart") or (target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("Torso")) or target.Character:FindFirstChild("HumanoidRootPart")
    if not part then return end
    local pos=PredictPos(target,part)
    local cam=WS.CurrentCamera
    local smooth=isMurderer(target) and 0.78 or State.Aim.sm
    cam.CFrame=cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position,pos),smooth)
end
