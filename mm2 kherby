local function predictMurdererPosSH(murderer)
    if not murderer or not murderer.Character then
        return nil
    end
    
    local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    updateNetworkMetrics()
    
    local targetPos = hrp.Position
    local velocity = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.new()
    
    local predictionTime = (NetworkMetrics.ping / 1000) + 0.085
    predictionTime = math.clamp(predictionTime, 0.03, 0.2)
    
    local predictedPos = targetPos + (velocity * predictionTime)
    
    if velocity.Y ~= 0 then
        local gravity = Workspace.Gravity
        local verticalPos = targetPos.Y + (velocity.Y * predictionTime) - 
                           (0.5 * gravity * predictionTime * predictionTime)
        predictedPos = Vector3.new(predictedPos.X, verticalPos, predictedPos.Z)
    end
    
    return predictedPos
end

local function stopSilentHacker()
    State.SilentHacker.isDesyncing = false
    State.SilentHacker.currentTarget = nil
    
    if State.SilentHacker.currentDesyncCoroutine then
        task.cancel(State.SilentHacker.currentDesyncCoroutine)
        State.SilentHacker.currentDesyncCoroutine = nil
    end
    
    Notifier.new({Title="Silent Hacker", Content="Deactivated", Duration=1.5})
end

local function performSilentHacker()
    if State.SilentHacker.isDesyncing then 
        return 
    end
    
    if not State.SilentHacker.Enabled then return end
    if not silentAimEnabled then 
        Notifier.new({Title="Silent Hacker", Content="Enable Silent Aim first!", Duration=2})
        return
    end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local murderer = findMurdererSilentHacker()
    if not murderer then 
        return 
    end
    
    State.SilentHacker.currentTarget = murderer
    
    local predictedPos = predictMurdererPosSH(murderer)
    if not predictedPos then return end
    
    State.SilentHacker.isDesyncing = true
    
    Notifier.new({Title="Silent Hacker ACTIVE", Content="Behind "..murderer.Name.." - AUTO SHOOTING!", Duration=3})
    
    if State.SilentHacker.currentDesyncCoroutine then
        task.cancel(State.SilentHacker.currentDesyncCoroutine)
    end
    
    State.SilentHacker.currentDesyncCoroutine = task.spawn(function()
        local startTime = tick()
        local timeRemaining = State.SilentHacker.Duration
        
        while timeRemaining > 0 and State.SilentHacker.isDesyncing do
            timeRemaining = State.SilentHacker.Duration - (tick() - startTime)
            
            if not rootPart or not rootPart.Parent then
                stopSilentHacker()
                return
            end
            
            murderer = findMurdererSilentHacker()
            if not murderer or not isAlive(murderer) then
                stopSilentHacker()
                return
            end
            
            State.SilentHacker.currentTarget = murderer
            
            local newPredictedPos = predictMurdererPosSH(murderer)
            if not newPredictedPos then
                task.wait(0.016)
                continue
            end
            
            predictedPos = newPredictedPos
            
            local murdererHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
            if not murdererHRP then
                task.wait(0.016)
                continue
            end
            
            local murdererLookVector = murdererHRP.CFrame.LookVector
            local behindPosition = predictedPos - (murdererLookVector * State.SilentHacker.BehindDistance)
            behindPosition = Vector3.new(behindPosition.X, predictedPos.Y, behindPosition.Z)
            
            local behindCFrame = CFrame.lookAt(behindPosition, predictedPos)
            
            local clientVisualPosition = rootPart.CFrame
            
            rootPart.CFrame = behindCFrame
            
            RunService.Heartbeat:Wait()
            
            if rootPart and rootPart.Parent then
                rootPart.CFrame = clientVisualPosition
            end
            
            task.wait(0.016)
        end
        
        stopSilentHacker()
    end)
    
    return murderer.Name
end

