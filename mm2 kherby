local function getNetworkPing()
    local ping = 0
    local success = pcall(function()
        ping = LocalPlayer:GetNetworkPing() * 1000
    end)
    
    if ping == 0 then
        local stats = Stats.Network.ServerStatsItem["Data Ping"]
        if stats then
            ping = tonumber(stats:GetValueString():match("%d+")) or 0
        end
    end
    
    return math.clamp(ping, 2, 500)
end

local function calculateStandardDeviation(data)
    if #data < 2 then return 0 end
    
    local sum = 0
    for _, v in ipairs(data) do
        sum = sum + v
    end
    local mean = sum / #data
    
    local varianceSum = 0
    for _, v in ipairs(data) do
        varianceSum = varianceSum + (v - mean) ^ 2
    end
    
    return math.sqrt(varianceSum / #data)
end

local function updateNetworkMetrics()
    local currentTime = tick()
    if currentTime - NetworkMetrics.lastUpdate < 0.1 then
        return
    end
    
    local rawPing = getNetworkPing()
    table.insert(NetworkMetrics.history, 1, rawPing)
    
    if #NetworkMetrics.history > NetworkMetrics.maxHistory then
        table.remove(NetworkMetrics.history)
    end
    
    if #NetworkMetrics.history >= 30 then
        local recentPings = {}
        for i = 1, math.min(50, #NetworkMetrics.history) do
            table.insert(recentPings, NetworkMetrics.history[i])
        end
        
        local sum = 0
        for _, p in ipairs(recentPings) do
            sum = sum + p
        end
        local avgPing = sum / #recentPings
        
        NetworkMetrics.standardDeviation = calculateStandardDeviation(recentPings)
        NetworkMetrics.variance = NetworkMetrics.standardDeviation ^ 2
        NetworkMetrics.jitter = NetworkMetrics.standardDeviation * 0.6
        NetworkMetrics.ping = avgPing
        
        local stableCount = 0
        for _, p in ipairs(recentPings) do
            if math.abs(p - avgPing) < NetworkMetrics.standardDeviation * 1.5 then
                stableCount = stableCount + 1
            end
        end
        NetworkMetrics.stability = stableCount / #recentPings
        
        NetworkMetrics.RTTBuffer = (NetworkMetrics.ping + NetworkMetrics.jitter * 1.2) / 1000
    else
        NetworkMetrics.ping = rawPing
        NetworkMetrics.RTTBuffer = rawPing / 1000
        NetworkMetrics.stability = 0.5
    end
    
    NetworkMetrics.lastUpdate = currentTime
end

local function initPlayerData(player)
    if not PredictionSystem.playerData[player] then
        PredictionSystem.playerData[player] = {
            lastPosition = Vector3.new(),
            lastVelocity = Vector3.new(),
            lastTime = tick(),
            positionHistory = {},
            velocityHistory = {},
            lastTargetPart = "UpperTorso",
        }
    end
    return PredictionSystem.playerData[player]
end

local function predictPlayerPosition(player, targetPart)
    if not player or not player.Character then
        return targetPart and targetPart.Position or Vector3.new()
    end
    
    local character = player.Character
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return targetPart and targetPart.Position or Vector3.new()
    end
    
    updateNetworkMetrics()
    
    local data = initPlayerData(player)
    local currentTime = tick()
    local timeDelta = currentTime - data.lastTime
    
    local currentPos = hrp.Position
    local currentVel = hrp.Velocity
    
    table.insert(data.positionHistory, 1, {pos = currentPos, time = currentTime})
    if #data.positionHistory > 10 then
        table.remove(data.positionHistory)
    end
    
    table.insert(data.velocityHistory, 1, {vel = currentVel, time = currentTime})
    if #data.velocityHistory > 10 then
        table.remove(data.velocityHistory)
    end
    
    data.lastPosition = currentPos
    data.lastVelocity = currentVel
    data.lastTime = currentTime
    
    local finalTargetPart = "UpperTorso"
    local chosenPart = character:FindFirstChild(finalTargetPart) or character:FindFirstChild("Torso") or targetPart or hrp
    
    local targetPos = chosenPart.Position
    local velocity = chosenPart.AssemblyLinearVelocity or Vector3.new()
    
    local predictionTime = math.clamp(NetworkMetrics.RTTBuffer + 0.03, 0.04, 0.15)
    
    local predictedPos = targetPos + (velocity * predictionTime)
    
    if velocity.Y ~= 0 then
        local verticalPos = targetPos.Y + (velocity.Y * predictionTime) - (0.5 * PredictionSystem.gravity * predictionTime * predictionTime)
        predictedPos = Vector3.new(predictedPos.X, verticalPos, predictedPos.Z)
    end
    
    return predictedPos
end

