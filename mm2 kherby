local function SimpleFling(target)
    if State.Fling.active then return end
    State.Fling.active=true
    local c=LocalPlayer.Character
    local rp=c and c:FindFirstChild("HumanoidRootPart")
    if not rp then State.Fling.active=false return end
    local oldPos=rp.CFrame
    local bv=Instance.new("BodyVelocity")
    bv.Parent=rp
    bv.Velocity=Vector3.new(9e8,9e8,9e8)
    bv.MaxForce=Vector3.new(9e9,9e9,9e9)
    for i=1,15 do
        rp.CFrame=oldPos*CFrame.new(math.sin(i)*8,i,math.cos(i)*8)
        task.wait(0.03)
    end
    bv:Destroy()
    for i=1,5 do rp.CFrame=oldPos*CFrame.new(0,0.5,0) task.wait(0.1) end
    State.Fling.active=false
end

